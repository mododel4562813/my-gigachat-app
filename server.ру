import os
import json
import base64
import uuid
import requests
from datetime import datetime
from flask import Flask, request, jsonify, render_template
from dotenv import load_dotenv
import gspread
from google.oauth2.service_account import Credentials

from facts import find_fact  # локальная база

# ---------- Настройка путей ----------
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
load_dotenv(os.path.join(BASE_DIR, '.env'))
CERT_PATH = os.path.join(BASE_DIR, 'russia_trusted_root.pem')

app = Flask(__name__)

# ---------- GigaChat ----------
GIGACHAT_CLIENT_ID = os.getenv("GIGACHAT_CLIENT_ID")
GIGACHAT_CLIENT_SECRET = os.getenv("GIGACHAT_CLIENT_SECRET")
GIGACHAT_AUTH_URL = "https://ngw.devices.sberbank.ru:9443/api/v2/oauth"
GIGACHAT_API_URL = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions"

proxy_url = os.getenv("PROXY_URL")
proxies = {"http": proxy_url, "https": proxy_url} if proxy_url else None

if not GIGACHAT_CLIENT_ID or not GIGACHAT_CLIENT_SECRET:
    print("⚠️ Ключи GigaChat не найдены в .env — чат будет отключён")
else:
    print("✅ Ключи GigaChat найдены")

_token_cache = {"token": None, "time": 0}


def get_gigachat_token():
    """Получение токена GigaChat (с кэшем на 25 минут)."""
    import time
    if _token_cache["token"] and time.time() - _token_cache["time"] < 1500:
        return _token_cache["token"]

    if not GIGACHAT_CLIENT_ID or not GIGACHAT_CLIENT_SECRET:
        print("⚠️ Не заданы ключи GigaChat в .env")
        return None

    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
    }
    auth_string = f"{GIGACHAT_CLIENT_ID}:{GIGACHAT_CLIENT_SECRET}"
    headers['Authorization'] = 'Basic ' + base64.b64encode(
        auth_string.encode('utf-8')).decode('utf-8')

    payload = {'scope': 'GIGACHAT_API_PERS'}

    # Если файла сертификата нет — не проверяем SSL (иначе будет падать)
    verify = CERT_PATH if os.path.exists(CERT_PATH) else False
    if not os.path.exists(CERT_PATH):
        print("⚠️ Файл russia_trusted_root.pem не найден — SSL не проверяется")

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data=payload,
            verify=verify,
            proxies=proxies,
            timeout=15
        )
        print(f"📡 Авторизация GigaChat: статус {response.status_code}")
        response.raise_for_status()

        token = response.json().get('access_token')
        if token:
            print("✅ Токен GigaChat получен!")
            _token_cache["token"] = token
            _token_cache["time"] = time.time()
            return token
        print("⚠️ В ответе нет access_token:", response.text)
        return None
    except Exception as e:
        print(f"❌ Ошибка авторизации GigaChat: {e}")
        return None


def ask_gigachat(user_text):
    """Запрос к GigaChat."""
    token = get_gigachat_token()
    if not token:
        return None  # чат недоступен — вернёмся к «НЕЗНАЮ»

    prompt = (
        "Ты — медицинский фактчекер. Пользователь утверждает: \"" + user_text + "\". "
        "Проверь утверждение с научной точки зрения. Ответь СТРОГО в формате JSON "
        "(без markdown, только чистый JSON): {\"verdict\": \"МИФ\" | \"ПРАВДА\" | "
        "\"СПОРНО\" | \"НЕЗНАЮ\", \"explanation\": \"краткое объяснение\"}. "
        "Не давай медицинских назначений — вместо этого пиши «обратитесь к врачу»."
    )

    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }

    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1
    }

    verify = CERT_PATH if os.path.exists(CERT_PATH) else False

    try:
        response = requests.post(
            GIGACHAT_API_URL,
            headers=headers,
            json=payload,
            verify=verify,
            proxies=proxies,
            timeout=30
        )
        response.raise_for_status()
        content = response.json()['choices'][0]['message']['content']

        try:
            result = json.loads(content)
            return {
                "verdict": result.get("verdict", "НЕЗНАЮ"),
                "explanation": result.get("explanation", "")
            }
        except json.JSONDecodeError:
            # Модель вернула текст вместо JSON — отдаём его как объяснение
            return {"verdict": "НЕЗНАЮ", "explanation": content[:500]}
    except Exception as e:
        print(f"❌ Ошибка запроса к GigaChat: {e}")
        return None


# ---------- Google Sheets ----------
GS_CLIENT = None
USE_GOOGLE_SHEETS = os.path.exists(os.path.join(BASE_DIR, "credentials.json"))

if USE_GOOGLE_SHEETS:
    try:
        scopes = [
            "https://www.googleapis.com/auth/spreadsheets",
            "https://www.googleapis.com/auth/drive"
        ]
        creds = Credentials.from_service_account_file(
            os.path.join(BASE_DIR, "credentials.json"), scopes=scopes)
        GS_CLIENT = gspread.authorize(creds)
        print("✅ Google Таблицы подключены!")
    except Exception as e:
        print(f"⚠️ Ошибка подключения к Google Sheets: {e}")
        USE_GOOGLE_SHEETS = False
else:
    print("ℹ️ credentials.json не найден — Google Sheets отключён")


def search_sheets(user_text):
    """Поиск ответа в листе Facts (колонки: Утверждение, Вердикт, Объяснение)."""
    if not GS_CLIENT:
        return None
    try:
        spreadsheet_id = os.getenv("GOOGLE_SPREADSHEET_ID")
        if not spreadsheet_id:
            print("⚠️ Не задан GOOGLE_SPREADSHEET_ID в .env")
            return None
        spreadsheet = GS_CLIENT.open_by_key(spreadsheet_id)
        records = spreadsheet.worksheet("Facts").get_all_records()
        user_text = user_text.lower().strip()

        for row in records:
            claim = str(row.get('Утверждение', '')).lower()
            # Совпадение: фраза пользователя в утверждении или ключевые слова в ней
            if user_text in claim or any(w in claim for w in user_text.split() if len(w) > 4):
                return {
                    "source": "google_sheets",
                    "verdict": row.get('Вердикт', 'НЕЗНАЮ'),
                    "explanation": row.get('Объяснение', '')
                }
    except Exception as e:
        print(f"⚠️ Ошибка чтения Google Sheets: {e}")
    return None


def log_to_sheet(user_text, verdict):
    """Логирование запроса в лист Logs."""
    if not GS_CLIENT:
        return
    try:
        sheet = GS_CLIENT.open_by_key(os.getenv("GOOGLE_SPREADSHEET_ID"))
        sheet.worksheet("Logs").append_row(
            [user_text, verdict, datetime.now().strftime("%Y-%m-%d %H:%M")])
    except Exception as e:
        print(f"⚠️ Ошибка логирования в Sheets: {e}")


# ---------- Маршруты ----------
@app.route('/')
def index():
    return render_template('index.html')


@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).lower().strip()

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    result = None

    # 1. Google Sheets
    result = search_sheets(user_text)

    # 2. Локальная база
    if not result:
        result = find_fact(user_text)

    # 3. GigaChat
    if not result:
        result = ask_gigachat(user_text)

    # 4. Ничего не нашлось
    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": "Информация не найдена. Сервис работает в офлайн-режиме — попробуйте позже или переформулируйте запрос."
        }

    log_to_sheet(user_text, result.get("verdict", "НЕЗНАЮ"))
    print(f"[LOG] '{user_text}' -> {result.get('verdict')} ({result.get('source')})")
    return jsonify(result)


@app.route('/api/rate', methods=['POST'])
def rate_answer():
    data = request.get_json() or {}
    claim = data.get('claim')
    rating = data.get('rating')

    if not claim or rating is None:
        return jsonify({"error": "Нужны поля 'claim' и 'rating'"}), 400

    if GS_CLIENT:
        try:
            sheet = GS_CLIENT.open_by_key(os.getenv("GOOGLE_SPREADSHEET_ID"))
            sheet.worksheet("Ratings").append_row(
                [claim, rating, datetime.now().strftime("%Y-%m-%d %H:%M")])
            return jsonify({"status": "ok"})
        except Exception as e:
            print(f"⚠️ Ошибка записи оценки: {e}")
            return jsonify({"status": "ok", "warning": "Оценка не записана"})
    return jsonify({"status": "ok", "warning": "Sheets не подключен"})


@app.route('/api/review', methods=['POST'])
def submit_review():
    data = request.get_json() or {}
    name = data.get('name', 'Аноним')
    review_text = str(data.get('review', '')).strip()

    if not review_text:
        return jsonify({"error": "Пустой отзыв"}), 400

    if GS_CLIENT:
        try:
            sheet = GS_CLIENT.open_by_key(os.getenv("GOOGLE_SPREADSHEET_ID"))
            sheet.worksheet("Reviews").append_row(
                [name, review_text, datetime.now().strftime("%Y-%m-%d %H:%M")])
        except Exception as e:
            print(f"⚠️ Ошибка записи отзыва: {e}")
            return jsonify({"status": "ok", "warning": "Отзыв не записан"})
    else:
        print(f"🗣 [ОТЗЫВ] {name}: {review_text}")

    return jsonify({"status": "ok"})


if __name__ == '__main__':
    print("🚀 Сервер запущен...")
    port = int(os.environ.get('PORT', 8080))
    app.run(host='0.0.0.0', port=port, debug=True)
