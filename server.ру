_token_cache = {"token": None, "time": 0}

ALLOWED_VERDICTS = ("МИФ", "ПРАВДА", "СПОРНО", "НЕЗНАЮ")
AMBULANCE_NOTE = ("Немедленно вызовите скорую помощь: 103 (с мобильного) "
                  "или 112 (единый номер экстренных служб).")


def _gigachat_verify():
    return CERT_PATH if os.path.exists(CERT_PATH) else False


def _auth_header_value():
    if GIGACHAT_AUTH_KEY:
        return 'Basic ' + GIGACHAT_AUTH_KEY
    auth_string = f"{GIGACHAT_CLIENT_ID}:{GIGACHAT_CLIENT_SECRET}"
    return 'Basic ' + base64.b64encode(auth_string.encode('utf-8')).decode('utf-8')


def get_gigachat_token():
    if _token_cache["token"] and time.time() - _token_cache["time"] < 1500:
        return _token_cache["token"]

    if not (GIGACHAT_AUTH_KEY or (GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET)):
        return None

    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
        'Authorization': _auth_header_value(),
    }

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=15
        )
        print(f"📡 Авторизация GigaChat: статус {response.status_code}")
        response.raise_for_status()

        token = response.json().get('access_token')
        if token:
            print("✅ Токен GigaChat получен!")
            _token_cache["token"] = token
            _token_cache["time"] = time.time()
            return token

        print("⚠️ В ответе нет access_token:", response.text[:200])
        return None
    except Exception as e:
        print(f"❌ Ошибка авторизации GigaChat: {e!r}")
        return None


def _extract_json(text):
    text = text.strip()
    if text.startswith("```"):
        text = text.strip("`")
        if text.lower().startswith("json"):
            text = text[4:]
        text = text.strip()
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end != -1 and end > start:
        return text[start:end + 1]
    return text


def _normalize_verdict(raw):
    """Разрешённые вердикты; всё остальное (АБСУРД и т. п.) — НЕЗНАЮ."""
    v = str(raw).upper().strip()
    if v in ALLOWED_VERDICTS:
        return v
    if "ПРАВДА" in v or "ИСТИНА" in v:
        return "ПРАВДА"
    if "МИФ" in v:
        return "МИФ"
    if "СПОРН" in v:
        return "СПОРНО"
    return "НЕЗНАЮ"


def ask_gigachat(user_text):
    token = get_gigachat_token()
    if not token:
        return None

    prompt = f"""Ты — строгий, авторитетный медицинский фактчекер. Твоя единственная задача — проверить конкретное утверждение пользователя и дать научно обоснованный вердикт.

Утверждение пользователя: "{user_text}"

СТРОГИЕ ПРАВИЛА ДЛЯ ОТВЕТА:
1. Концентрация на теме: Твой ответ должен быть строго сфокусирован ТОЛЬКО на объектах и понятиях из утверждения пользователя (если вопрос про чеснок, пиши только про чеснок; упоминать другие продукты или методы запрещено).
2. Оценка реалистичности: Если утверждение описывает физически или биологически невозможное для человека явление (например, «температура тела 60°C — это норма»), ставь вердикт «МИФ» и объясняй физическую невозможность. Различай: опасное значение, о котором говорит пользователь (например, температура 42°C), — это не абсурд утверждения, а реальная опасность, о которой нужно подтвердить или опровергнуть утверждение по существу.
3. Доказательная медицина: Опирайся только на подтвержденные научные данные. Не давай медицинских назначений и советов по лечению.
4. Калибровка вердикта: Используй «МИФ» только для утверждений, НАУЧНО ОПРОВЕРГНУТЫХ или физически невозможных. Если научные данные противоречивы, эффект слабый, проявляется только в лабораторных условиях или недостаточно изучен в клинических исследованиях — ставь вердикт «СПОРНО», а не «МИФ». Пример: у вещества есть отдельные лабораторные эффекты, но клиническая польза не доказана — это «СПОРНО».
5. Экстренные состояния: Если утверждение касается угрожающего жизни состояния или необходимости срочной медицинской помощи, оцени его по существу. Если утверждение верно — ставь «ПРАВДА» и в explanation обязательно добавь фразу: «Немедленно вызовите скорую помощь: 103 (с мобильного) или 112 (единый номер экстренных служб)». Если утверждение неверно (советы при экстренном состоянии опасны) — ставь «МИФ» и тоже указывай этот номер.
6. Разрешённые вердикты — ТОЛЬКО: «МИФ», «ПРАВДА», «СПОРНО», «НЕЗНАЮ». Любые другие слова (например, «АБСУРД») запрещены — выбирай ближайший подходящий из четырёх разрешённых.

Верни ответ СТРОГО в формате JSON (без markdown-разметки, без тройных кавычек ```json, только чистый JSON):
{{
  "verdict": "МИФ" | "ПРАВДА" | "СПОРНО" | "НЕЗНАЮ",
  "explanation": "Лаконичное, строгое научное объяснение причин (максимум 3-4 предложения). Если вопрос требует индивидуальной консультации врача или выходит за рамки твоей компетенции, напиши ровно следующую фразу: 'Я не компетентна в этом вопросе, пожалуйста, обратитесь к специалисту.'"
}}"""

    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }
    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1
    }

    try:
        response = requests.post(
            GIGACHAT_API_URL,
            headers=headers,
            json=payload,
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=30
        )
        response.raise_for_status()
        content = response.json()['choices'][0]['message']['content']
        content = _extract_json(content)

        try:
            result = json.loads(content)
            explanation = str(result.get("explanation", ""))
            verdict = _normalize_verdict(result.get("verdict", "НЕЗНАЮ"))

            danger_words = ("скорую", "скорая", "срочно", "немедленно",
                            "угрожает жизни", "критическ", "экстренн")
            if verdict in ("ПРАВДА", "МИФ") and any(
                    w in explanation.lower() for w in danger_words) and "103" not in explanation:
                explanation = explanation.rstrip(".") + ". " + AMBULANCE_NOTE

            return {
                "source": "gigachat",
                "verdict": verdict,
                "explanation": explanation
            }
        except json.JSONDecodeError:
            return {"source": "gigachat", "verdict": "НЕЗНАЮ",
                    "explanation": content[:500]}
    except Exception as e:
        print(f"❌ Ошибка запроса к GigaChat: {e!r}")
        return None


