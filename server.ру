def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).strip()
    username = str(data.get('username', '')).strip()[:50] or None

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    text_lower = user_text.lower()
    norm_key = normalize_text(text_lower)

    # 1. Локальная база -> 2. Кэш -> 3. Google Sheets -> 4. GigaChat
    result = None
    try:
        result = find_fact(norm_key)
    except Exception:
        result = None
    if not result:
        cached = cache_get(norm_key)
        if cached:
            result = {"source": "cache", "verdict": cached["verdict"],
                      "explanation": cached["explanation"]}
    if not result:
        result = search_sheets(norm_key)
    if not result:
        result = ask_gigachat(text_lower)
        if result and result.get("verdict") not in ("НЕЗНАЮ", None):
            add_fact_to_sheet(text_lower, result["verdict"],
                              result.get("explanation", ""))
            cache_put(norm_key, result["verdict"], result.get("explanation", ""))

    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": ("Я не нашла этот факт в проверенной базе, и сейчас не могу "
                            "подключить нейросеть. Не верьте домыслам — проверьте "
