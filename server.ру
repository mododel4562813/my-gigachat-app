def update_streak_in_sheet(username):
    """
    НОВОЕ: серверная серия дней. Вызывается ТОЛЬКО для зарегистрированных
    пользователей (есть в листе Users). Логика: зашёл сегодня впервые —
    если был вчера, серия +1, иначе серия обнуляется до 1.
    Возвращает словарь со свежими данными или None (нет пользователя/таблицы).
    """
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID or not username:
        return None
    try:
        sheet = get_sheet()
        if sheet is None:
            return None
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return None
        colmap = _users_colmap(ws)
        if not colmap:
            return None

        row_idx, row = _find_user(ws, colmap, username)
        if row_idx is None:
            return None  # только зарегистрированные копят серию

        today = date.today().isoformat()
        yesterday = (date.today() - timedelta(days=1)).isoformat()

        c_last = colmap.get("Последний визит", 2)
        c_streak = colmap.get("Серия", 3)
        c_best = colmap.get("Лучшая серия", 4)
        c_total = colmap.get("Всего дней", 5)

        last_visit = _cell_str(row, c_last)
        streak = _cell_int(row, c_streak)
        best = _cell_int(row, c_best)
        total = _cell_int(row, c_total)

        if last_visit != today:
            streak = streak + 1 if last_visit == yesterday else 1
            total += 1
            best = max(best, streak)
            ws.update_cell(row_idx, c_last, today)
            ws.update_cell(row_idx, c_streak, streak)
            ws.update_cell(row_idx, c_best, best)
            ws.update_cell(row_idx, c_total, total)

        avatar_cell = _cell_str(row, colmap.get("Аватар (base64)", 6))
        return {
            "streak": streak,
            "best_streak": best,
            "total_days": total,
            "avatar": avatar_url_for(username) if avatar_cell else None
        }
    except Exception:
        print("⚠️ Ошибка обновления серии:")
        traceback.print_exc()
        return None


def _save_avatar_b64(username, data_bytes, mime):
    """Сохраняет аватар в лист Users (base64) и сбрасывает кэш."""
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return False
    try:
        sheet = get_sheet()
        if sheet is None:
            return False
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return False
        colmap = _users_colmap(ws)
        if not colmap:
            return False
        row_idx, _row = _find_user(ws, colmap, username)
        if row_idx is None:
            return False
        encoded = base64.b64encode(data_bytes).decode('ascii')
        # лимит ячейки Google Sheets — 50 000 символов
        if len(encoded) > 45000:
            return False
        ws.update_cell(row_idx, colmap.get("Аватар (base64)", 6), encoded)
        version = hashlib.md5(data_bytes).hexdigest()[:8]
        _avatar_cache[username.lower()] = (data_bytes, mime, version)
        return True
    except Exception:
        print("⚠️ Ошибка сохранения аватара:")
        traceback.print_exc()
        return False


def _load_avatar_bytes(username):
    """Достаёт аватар из кэша или из таблицы. Возвращает (bytes, mime, version) или None."""
    key = (username or "").strip().lower()
    if not key:
        return None
    if key in _avatar_cache:
        return _avatar_cache[key]
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return None
    try:
        sheet = get_sheet()
        if sheet is None:
            return None
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return None
        colmap = _users_colmap(ws)
        if not colmap:
            return None
        row_idx, row = _find_user(ws, colmap, key)
        if row_idx is None:
            return None
        encoded = _cell_str(row, colmap.get("Аватар (base64)", 6))
        if not encoded:
            return None
        data = base64.b64decode(encoded)
        record = (data, "image/jpeg", hashlib.md5(data).hexdigest()[:8])
        _avatar_cache[key] = record
        return record
    except Exception:
        print("⚠️ Ошибка чтения аватара:")
        traceback.print_exc()
        return None


def _shrink_image(raw_bytes):
    """Сжимает картинку до квадрата 256px JPEG. Возвращает (bytes, mime) или None."""
    if not PIL_OK:
        return None
    try:
        img = Image.open(io.BytesIO(raw_bytes))
        img = img.convert("RGB")
        img.thumbnail((AVATAR_SIDE, AVATAR_SIDE))
        buf = io.BytesIO()
        img.save(buf, format="JPEG", quality=AVATAR_JPEG_QUALITY)
        return buf.getvalue(), "image/jpeg"
    except Exception:
        print("⚠️ Не удалось обработать изображение:")
        traceback.print_exc()
        return None


