# ---------- Helper Functions ----------

def _gigachat_verify():
    return CERT_PATH if os.path.exists(CERT_PATH) else False

def _auth_header_value():
    if GIGACHAT_AUTH_KEY:
        return 'Basic ' + GIGACHAT_AUTH_KEY
    auth_string = f"{GIGACHAT_CLIENT_ID}:{GIGACHAT_CLIENT_SECRET}"
    return 'Basic ' + base64.b64encode(auth_string.encode('utf-8')).decode('utf-8')

def get_gigachat_token():
    if _token_cache["token"] and time.time() - _token_cache["time"] < 1500:
        return _token_cache["token"]

    if not (GIGACHAT_AUTH_KEY or (GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET)):
        return None

    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
        'Authorization': _auth_header_value(),
    }

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=15
        )
        response.raise_for_status()
        token = response.json().get('access_token')
        if token:
            _token_cache["token"] = token
            _token_cache["time"] = time.time()
            return token
        return None
    except Exception as e:
        print(f"❌ Ошибка авторизации GigaChat: {e}")
        return None

def _extract_json(text):
    text = text.strip()
    if text.startswith("```"):
        text = text.strip("`")
        if text.lower().startswith("json"):
            text = text[4:]
        text = text.strip()
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end != -1 and end > start:
        return text[start:end + 1]
    return text

def _normalize_verdict(raw):
    v = str(raw).upper().strip()
    if v in ALLOWED_VERDICTS:
        return v
    if "ПРАВДА" in v or "ИСТИНА" in v:
        return "ПРАВДА"
    if "МИФ" in v:
        return "МИФ"
    if "СПОРН" in v:
        return "СПОРНО"
    return "НЕЗНАЮ"

def _is_absurd_myth(verdict, explanation):
    """
    Фильтр абсурда.
    Если вердикт МИФ, но объяснение звучит как 'научно опровергнуто' для очевидных вещей (гигиена, вода, воздух),
    мы считаем это ошибкой ИИ и меняем вердикт на СПОРНО или ПРАВДА.
    """
    if verdict != "МИФ":
        return False
    
    exp_lower = explanation.lower()
    # Ключевые триггеры абсурда
    absurd_triggers = [
        "научно опровергнуто",
        "не работает",
        "бессмысленно",
        "не имеет смысла"
    ]
    
    # Темы, которые ИИ часто ошибочно называет мифами
    sensitive_topics = [
        "гигиена", "мыть руки", "чистота", "дезинфекция", 
        "пить воду", "воздух", "сон", "еда"
    ]

    has_trigger = any(t in exp_lower for t in absurd_triggers)
    has_sensitive = any(t in exp_lower for t in sensitive_topics)

    if has_trigger and has_sensitive:
        return True
    return False

def ask_gigachat(user_text):
    token = get_gigachat_token()
    if not token:
        return None

    prompt = f"""Ты — строгий медицинский фактчекер. Твоя задача — проверить утверждение и дать вердикт.

Утверждение пользователя: "{user_text}"

СТРОГИЕ ПРАВИЛА:
1. Вердикт ТОЛЬКО: «МИФ», «ПРАВДА», «СПОРНО», «НЕЗНАЮ».
2. Если утверждение касается базовой гигиены, безопасности или очевидных физиологических потребностей (сон, вода, воздух) — НЕ называй это мифом, даже если эффект кажется слабым. Для таких случаев используй «СПОРНО» (если есть нюансы) или «ПРАВДА» (если польза доказана).
3. Никогда не пиши «Научно опровергнуто» для утверждений про гигиену или базовые потребности человека.
4. Верни ответ СТРОГО в формате JSON:
{{
  "verdict": "МИФ" | "ПРАВДА" | "СПОРНО" | "НЕЗНАЮ",
  "explanation": "Лаконичное объяснение (максимум 3 предложения)"
}}"""

    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }
    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1
    }

    try:
        response = requests.post(
            GIGACHAT_API_URL,
            headers=headers,
            json=payload,
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=30
        )
        response.raise_for_status()
        content = response.json()['choices']['message']['content']
        content = _extract_json(content)

        try:
            result = json.loads(content)
            explanation = str(result.get("explanation", ""))
            verdict = _normalize_verdict(result.get("verdict", "НЕЗНАЮ"))

            # --- ГЛАВНЫЙ ФИЛЬТР ОТ АБСУРДА ---
            if _is_absurd_myth(verdict, explanation):
                print("⚠️ Обнаружен абсурдный ответ от ИИ. Исправляем вердикт на СПОРНО.")
                verdict = "СПОРНО"
                explanation = "Существуют научные данные, подтверждающие важность этого фактора, однако степень влияния может варьироваться. Не следует считать это полностью опровергнутым."
            # ---------------------------------

            return {
                "source": "gigachat",
                "verdict": verdict,
                "explanation": explanation
            }
        except json.JSONDecodeError:
            return {"source": "gigachat", "verdict": "НЕЗНАЮ", "explanation": content[:500]}
    except Exception as e:
        print(f"❌ Ошибка запроса к GigaChat: {e}")
        return None

