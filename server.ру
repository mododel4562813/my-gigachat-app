# В лист Users добавляются колонки (сами, при первом обращении):
#   «Последний визит» | «Серия» | «Лучшая серия» | «Всего дней» | «Аватар (base64)»
USER_EXTRA_HEADERS = ["Последний визит", "Серия", "Лучшая серия",
                      "Всего дней", "Аватар (base64)"]


def _users_colmap(ws):
    """Проверяет/создаёт шапку листа Users и возвращает {имя колонки: номер (с 1)}."""
    if ws is None:
        return None
    try:
        values = ws.get_all_values()
        header = values[0] if values else []
        colmap = {}
        for i, name in enumerate(header):
            colmap[str(name).strip()] = i + 1
        for extra in USER_EXTRA_HEADERS:
            if extra not in colmap:
                new_idx = len(header) + 1
                ws.update_cell(1, new_idx, extra)
                colmap[extra] = new_idx
                header.append(extra)
        return colmap
    except Exception:
        print("⚠️ Ошибка чтения шапки Users:")
        traceback.print_exc()
        return None


def _find_user(ws, colmap, username):
    """Ищет пользователя по логину. Возвращает (номер_строки, значения_строки) или (None, None).
    Номер строки — с учётом шапки, как этого ждёт update_cell."""
    if ws is None or not username:
        return None, None
    try:
        values = ws.get_all_values()
        target = username.strip().lower()
        for i, row in enumerate(values[1:]):
            if row and str(row[0]).strip().lower() == target:
                return i + 2, row  # +2: шапка в строке 1, список с нуля
        return None, None
    except Exception:
        print("⚠️ Ошибка поиска пользователя:")
        traceback.print_exc()
        return None, None


def _cell_int(row, col_idx, default=0):
    try:
        raw = str(row[col_idx - 1]).strip()
        return int(float(raw)) if raw else default
    except (ValueError, IndexError):
        return default


def _cell_str(row, col_idx):
    try:
        return str(row[col_idx - 1]).strip()
    except IndexError:
        return ""


