GS_CLIENT = None
GOOGLE_SPREADSHEET_ID = os.getenv("GOOGLE_SPREADSHEET_ID", "").strip()
GOOGLE_CREDENTIALS = os.getenv("GOOGLE_CREDENTIALS")
GOOGLE_CREDENTIALS_B64 = os.getenv("GOOGLE_CREDENTIALS_B64", "").strip()
CREDENTIALS_FILE = os.path.join(BASE_DIR, "credentials.json")

scopes = [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/drive"
]

def _load_credentials_info():
    if GOOGLE_CREDENTIALS_B64:
        return json.loads(base64.b64decode(GOOGLE_CREDENTIALS_B64).decode('utf-8'))
    if GOOGLE_CREDENTIALS:
        raw = GOOGLE_CREDENTIALS.strip()
        if raw.startswith('"') and raw.endswith('"'):
            raw = raw[1:-1]
        return json.loads(raw)
    if os.path.exists(CREDENTIALS_FILE):
        with open(CREDENTIALS_FILE, encoding='utf-8') as f:
            return json.load(f)
    return None

if GOOGLE_SPREADSHEET_ID:
    try:
        info = _load_credentials_info()
        if info:
            creds = Credentials.from_service_account_info(info, scopes=scopes)
            GS_CLIENT = gspread.authorize(creds)
            print("✅ Google Таблицы подключены")
        else:
            print("⚠️ Нет ключа для таблиц")
    except Exception as e:
        print("❌ Ошибка подключения к Google Sheets:")
        traceback.print_exc()
        GS_CLIENT = None
else:
    print("ℹ️ GOOGLE_SPREADSHEET_ID не задан")

def get_sheet():
    if not GS_CLIENT:
        return None
    try:
        return GS_CLIENT.open_by_key(GOOGLE_SPREADSHEET_ID)
    except Exception:
        return None

def ensure_worksheet(sheet, title):
    if not sheet:
        return None
    try:
        return sheet.worksheet(title)
    except Exception:
        try:
            return sheet.add_worksheet(title=title, rows=100, cols=10)
        except Exception:
            return None

def _stem(word):
    for suf in ("ами", "ями", "ого", "его", "ому", "ему", "ыми", "ими",
                "ой", "ый", "ий", "ая", "яя", "ую", "юю", "ом", "ем",
                "ах", "ях", "ей", "ов", "ев", "у", "ю", "а", "я", "ы",
                "и", "е", "ь"):
        if word.endswith(suf) and len(word) - len(suf) >= 4:
            return word[:-len(suf)]
    return word

def search_sheets(user_text):
    """
    Безопасный поиск в Google Sheets.
    Теперь проверяет наличие листа и колонок, чтобы избежать list index out of range.
    """
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return None
    
    sheet = get_sheet()
    if not sheet:
        return None

    ws = ensure_worksheet(sheet, "Facts")
    if not ws:
        print("⚠️ Лист 'Facts' не найден и не создан.")
        return None

    try:
        # get_all_records() вернет пустой список , если лист пуст, ошибки не будет
        records = ws.get_all_records()
        if not records:
            return None
            
        user_text = user_text.lower().strip()
        query_words = [w for w in user_text.split() if len(w) > 3]
        query_stems = [_stem(w) for w in query_words]
        
        if not query_stems:
            return None

        best_row = None
        best_score = 0
        
        for row in records:
            # Безопасное получение колонки 'Утверждение'
            claim = str(row.get('Утверждение', '')).lower()
            if not claim:
                continue
                
            score = 0
            # Подсчет совпадений
            claim_stems = [_stem(w) for w in claim.split()]
            for qs in query_stems:
                for cs in claim_stems:
                    if cs.startswith(qs) or qs.startswith(cs):
                        score += 1
                        break
            
            if user_text in claim:
                score += 10
            
            if score > best_score:
                best_score = score
                best_row = row

        if best_row and best_score >= max(2, len(query_stems) // 2):
            return {
                "source": "google_sheets",
                "verdict": best_row.get('Вердикт', 'НЕЗНАЮ'),
                "explanation": best_row.get('Объяснение', '')
            }
    except Exception as e:
        print(f"⚠️ Ошибка чтения Google Sheets: {e}")
        traceback.print_exc()
    
    return None

def add_fact_to_sheet(user_text, verdict, explanation):
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return
    try:
        sheet = get_sheet()
        if not sheet: return
        ws = ensure_worksheet(sheet, "Facts")
        if ws:
            ws.append_row([user_text, verdict, explanation, datetime.now().strftime("%Y-%m-%d %H:%M")])
    except Exception:
        print("⚠️ Ошибка добавления факта в таблицу")

