        return sheet.worksheet(title)
    except Exception:
        try:
            return sheet.add_worksheet(title=title, rows=100, cols=10)
        except Exception:
            return None


def sheet_append(sheet_title, row):
    """Безопасно дописывает строку в лист. Никогда не падает."""
    try:
        sheet = get_sheet()
        if sheet is None:
            return
        ws = ensure_worksheet(sheet, sheet_title)
        if ws is None:
            return
        ws.append_row(row)
    except Exception:
        pass


def ensure_headers(ws, headers):
    """Гарантирует, что в листе есть строка заголовков и нужные колонки."""
    try:
        first = ws.row_values(1)
        if not first or not any(str(c).strip() for c in first):
            ws.insert_row(headers, 1)
            return
        existing = [str(c).strip() for c in first]
        for h in headers:
            if h not in existing:
                ws.update_cell(1, len(existing) + 1, h)
                existing.append(h)
    except Exception:
        pass


def append_row_by_headers(ws, data_map):
    """Пишет строку по заголовкам — колонки не перепутаются."""
    try:
        header = [str(c).strip() for c in ws.row_values(1)]
        row = [data_map.get(h, "") for h in header]
        ws.append_row(row)
    except Exception:
        pass


def _prune_rate_dict(rate_dict, now, limit=500):
    """Чистит словарь лимитов «на месте» — без переприсваивания."""
    if len(rate_dict) > limit:
        cutoff = now - 3600
        for key in [k for k, v in rate_dict.items() if v <= cutoff]:
            rate_dict.pop(key, None)


