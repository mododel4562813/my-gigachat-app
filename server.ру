        return jsonify({"error": "Напишите, почему вы не согласны"}), 400
    if len(reason) < 5:
        return jsonify({"error": "Опишите причину чуть подробнее"}), 400
    if len(reason) > 500:
        return jsonify({"error": "Слишком длинное сообщение — уложитесь в 500 символов"}), 400

    # Антиспам: не чаще 1 раза в минуту с одного адреса
    ip = request.remote_addr or "?"
    now = time.time()
    last = _challenge_times.get(ip, 0)
    if now - last < CHALLENGE_COOLDOWN:
        wait = int(CHALLENGE_COOLDOWN - (now - last))
        return jsonify({"error": f"Подождите {wait} сек. перед новой перепроверкой 🙂"}), 429
    _challenge_times[ip] = now

    # Спор уходит в лист Disputes на модерацию команды
    try:
        sheet = get_sheet()
        if sheet:
            ws = ensure_worksheet(sheet, "Disputes")
            if ws:
                ws.append_row([claim[:200], reason[:500], "новый", "",
                               datetime.now().strftime("%Y-%m-%d %H:%M")])
    except Exception:
        print("⚠️ Не удалось записать спор:")
        traceback.print_exc()

    answer = ask_gigachat_challenge(claim, verdict, reason)
    if not answer:
        return jsonify({"error": "Не удалось перепроверить ответ. Попробуйте позже"}), 503
