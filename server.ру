_answer_cache = {}
CACHE_MAX_SIZE = 500


def normalize_text(text):
    text = str(text).lower().strip()
    text = re.sub(r"[^\w\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def cache_get(key):
    record = _answer_cache.get(key)
    if record is None:
        return None
    if time.time() - record["ts"] > 3 * 3600:
        _answer_cache.pop(key, None)
        return None
    return record


def cache_put(key, verdict, explanation):
    if len(_answer_cache) >= CACHE_MAX_SIZE:
        oldest = min(_answer_cache, key=lambda k: _answer_cache[k]["ts"])
        _answer_cache.pop(oldest, None)
    _answer_cache[key] = {"verdict": verdict, "explanation": explanation, "ts": time.time()}


