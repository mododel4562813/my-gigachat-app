        except Exception as e:
            print(f"⚠️ Ошибка логирования в Sheets: {e}")
    
    print(f"[LOG] Запрос: '{user_text}' -> Вердикт: {result.get('verdict', 'НЕЗНАЮ')}")
    return jsonify(result)

