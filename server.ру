            result = {"source": "cache", "verdict": cached["verdict"],
                      "explanation": cached["explanation"]}
    if not result:
        result = search_sheets(norm_key)
    if not result:
        result = ask_gigachat(text_lower)
        if result and result.get("verdict") not in ("НЕЗНАЮ", None):
            add_fact_to_sheet(text_lower, result["verdict"],
                              result.get("explanation", ""))
            cache_put(norm_key, result["verdict"], result.get("explanation", ""))

    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": ("Я не нашла этот факт в проверенной базе, и сейчас не могу "
