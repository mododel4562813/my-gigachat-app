@app.route('/api/avatar', methods=['POST'])
def upload_avatar():
    username = str(request.form.get('username', '')).strip()[:50]
    if not username:
        return jsonify({"error": "Сначала войдите в аккаунт"}), 400

    file = request.files.get('avatar')
    if not file or not file.filename:
        return jsonify({"error": "Файл не выбран"}), 400

    raw = file.read()
    if len(raw) > AVATAR_MAX_UPLOAD:
        return jsonify({"error": "Файл больше 2 МБ"}), 400

    if PIL_OK:
        processed = _shrink_image(raw)
        if not processed:
            return jsonify({"error": "Это не похоже на изображение"}), 400
        data_bytes, mime = processed
    else:
        if len(raw) > 40000:
            return jsonify({"error": "Выберите картинку поменьше (до 40 КБ)"}), 400
        data_bytes, mime = raw, file.mimetype or "image/png"

    if not _save_avatar_b64(username, data_bytes, mime):
        return jsonify({"error": "Не удалось сохранить аватар"}), 500
    version = hashlib.md5(data_bytes).hexdigest()[:8]
