@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).lower().strip()
    
    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    result = None

    # 1. Ищем в Google Sheets
    if GS_CLIENT:
        try:
            statements_sheet = GS_CLIENT.worksheet("statements")
            records = statements_sheet.get_all_records()
            for row in records:
                claim = str(row.get('Утверждение', '')).lower()
                if user_text in claim:
                    result = {
                        "verdict": row.get('Вердикт', 'НЕЗНАЮ'),
                        "explanation": row.get('Объяснение', '')
                    }
                    break
        except Exception as e:
            print(f"⚠️ Ошибка чтения Google Sheets: {e}")

    # 2. Ищем в локальной базе (Mock)
    if not result:
        for key, value in MOCK_FACTS.items():
            if key in user_text:
                result = {
                    "verdict": value.get("verdict"),
                    "explanation": value.get("explanation")
                }
                break

    # 3. Спрашиваем GigaChat (если ничего не нашли)
    if not result:
        result = ask_gigachat(user_text)

    # Логирование в таблицу (если подключена)
    if GS_CLIENT and result:
        try:
            log_sheet = GS_CLIENT.worksheet("Logs")
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")
            log_sheet.append_row([user_text, result['verdict'], timestamp])
        except Exception as e:
            print(f"⚠️ Ошибка логирования в Sheets: {e}")
    
    print(f"[LOG] Запрос: '{user_text}' -> Вердикт: {result.get('verdict', 'НЕЗНАЮ')}")
    return jsonify(result)


@app.route('/api/rate', methods=['POST'])
def rate_answer():
    data = request.get_json() or {}
    claim = data.get('claim')
    rating = data.get('rating')

    if not claim or rating is None:
        return jsonify({"error": "Недостаточно данных: нужны поля 'claim' и 'rating'"}), 400

    if GS_CLIENT:
        try:
            rating_sheet = GS_CLIENT.worksheet("Ratings")
            rating_sheet.append_row([claim, rating, datetime.now().strftime("%Y-%m-%d %H:%M")])
            print(f"✅ Оценка {rating}/5 для '{claim}' сохранена в таблицу.")
            return jsonify({"status": "ok"})
        except Exception as e:
            print(f"⚠️ Ошибка записи оценки в Sheets: {e}")
            return jsonify({"status": "ok", "warning": "Оценка не записана в таблицу"})
    else:
        print("⚠️ Google Sheets не подключен. Оценка не сохранена.")
        return jsonify({"status": "ok", "warning": "Google Sheets не подключен"})


@app.route('/api/review', methods=['POST'])
