# ============================================================
def _compute_myth_of_day():
    fallback = {"claim": None, "verdict": None, "explanation": "",
                "count": 0, "period": ""}
    if not GS_CLIENT:
        return fallback
    try:
        sheet = get_sheet()
        if sheet is None:
            return fallback
        ws = ensure_worksheet(sheet, "Logs")
        if ws is None:
            return fallback

        values = ws.get_all_values()
        today_str = datetime.now().strftime("%Y-%m-%d")
        week_ago = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d")

        counts_today, counts_week = Counter(), Counter()
        verdicts = {}
        for row in values[1:]:
            if len(row) < 3 or not str(row[0]).strip():
                continue
            claim = str(row[0]).strip()
            day = str(row[2])[:10]
            if day == today_str:
                counts_today[claim] += 1
            if week_ago <= day <= today_str:
                counts_week[claim] += 1
            verdicts[claim] = _normalize_verdict(row[1])

        counts, period = (counts_today, "сегодня") if counts_today \
            else (counts_week, "за неделю")
        if not counts:
            return fallback

        claim = counts.most_common(1)[0][0]
        info = _fact_lookup(claim) or {}
        return {"claim": claim,
                "verdict": info.get("verdict") or verdicts.get(claim),
                "explanation": info.get("explanation", ""),
