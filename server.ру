def ask_gigachat(user_text):
    token = get_gigachat_token()
    if not token:
        return None
    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }
    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user",
                      "content": CHECK_PROMPT.format(user_text=user_text,
                                                     ambulance=AMBULANCE_NOTE)}],
        "temperature": 0.1,
        "max_tokens": 400
    }
    try:
        response = requests.post(
            GIGACHAT_API_URL, headers=headers, json=payload,
            verify=_gigachat_verify(), proxies=proxies, timeout=30
        )
        response.raise_for_status()
        content = _extract_json(response.json()['choices'][0]['message']['content'])
        result = json.loads(content)
        verdict = _normalize_verdict(result.get("verdict", "НЕЗНАЮ"))
        explanation = str(result.get("explanation", ""))
        return {"source": "gigachat",
                "verdict": verdict,
                "explanation": _add_ambulance_if_needed(explanation, verdict)}
    except Exception as e:
        print(f"❌ Ошибка запроса к GigaChat: {e!r}")
        return None


