    """Отдаёт до 24 случайных мифов из листа Facts.
    В игру попадают только однозначные вердикты (МИФ/ПРАВДА) —
    СПОРНО и НЕЗНАЮ ломали бы бинарный выбор.
    Непроверенные ИИ-факты (Источник = «ai») в игру тоже не попадают.
    Сложность берём из колонки «Сложность» (1/2/3), если она заполнена."""
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return jsonify({"questions": []})
    try:
        sheet = get_sheet()
        if sheet is None:
            return jsonify({"questions": []})
        ws = ensure_worksheet(sheet, "Facts")
        if ws is None:
            return jsonify({"questions": []})
        records = ws.get_all_records()
        if not records:
            return jsonify({"questions": []})

        items = []
        for row in records:
            if str(row.get('Источник', '')).strip().lower() == "ai":
                continue
            claim = str(row.get('Утверждение', '')).strip()
            verdict = _normalize_verdict(row.get('Вердикт', ''))
            if not claim or verdict not in ("МИФ", "ПРАВДА"):
                continue
            try:
                difficulty = int(row.get('Сложность') or 1)
            except (TypeError, ValueError):
                difficulty = 1
            difficulty = max(1, min(3, difficulty))
            items.append({
                "statement": claim,
                "truth": verdict == "ПРАВДА",
                "explain": str(row.get('Объяснение', ''))[:300],
                "difficulty": difficulty
            })

        random.shuffle(items)
        return jsonify({"questions": items[:24]})
    except Exception:
        print("⚠️ Ошибка сбора вопросов для игры:")
        traceback.print_exc()
        return jsonify({"questions": []})


