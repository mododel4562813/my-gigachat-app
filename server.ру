def _stem(word):
    """Грубая обрезка русских окончаний: 'вирусами' -> 'вирус'."""
    for suf in ("ами", "ями", "ого", "его", "ому", "ему", "ыми", "ими",
                "ой", "ый", "ий", "ая", "яя", "ую", "юю", "ом", "ем",
                "ах", "ях", "ей", "ов", "ев", "у", "ю", "а", "я", "ы",
                "и", "е", "ь"):
        if word.endswith(suf) and len(word) - len(suf) >= 4:
            return word[:-len(suf)]
    return word


# Стоп-слова, которые не должны влиять на поиск
STOPWORDS = {"это", "правда", "или", "миф", "на", "самом", "деле",
             "вредно", "полезно", "есть", "что", "если", "так", "как",
             "про", "для", "можно", "нужно", "надо", "все", "очень"}


def _match_score(query_stems, claim):
    """Сколько ключевых слов запроса реально есть в утверждении."""
    claim_stems = [_stem(w) for w in claim.split()]
    score = 0
    for qs in query_stems:
        for cs in claim_stems:
            if cs.startswith(qs) or qs.startswith(cs):
                score += 1
                break
    return score


def _word_overlap(query_stems, claim):
    """Доля пересечения ключевых слов — второй сигнал для поиска."""
    claim_stems = set(_stem(w) for w in claim.split())
    if not query_stems or not claim_stems:
        return 0.0
    found = sum(1 for qs in query_stems
                if any(cs.startswith(qs) or qs.startswith(cs) for cs in claim_stems))
    return found / len(query_stems)


def search_sheets(user_text):
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return None
    try:
        sheet = get_sheet()
        if sheet is None:
            return None
        ws = ensure_worksheet(sheet, "Facts")
        if ws is None:
            return None
        records = ws.get_all_records()
        if not records:
            return None

        user_text = user_text.lower().strip()
        query_words = [w for w in user_text.split()
                       if len(w) > 3 and w not in STOPWORDS]
        query_stems = [_stem(w) for w in query_words]
        if not query_stems:
            return None

        best_row = None
        best_score = 0
        for row in records:
            # ИСПРАВЛЕНО: факты, добавленные ИИ (источник "ai"), в поиске не участвуют,
            # пока их не проверят руками (нужно поменять "ai" на "ok" в колонке «Источник»)
            if str(row.get('Источник', '')).strip().lower() == "ai":
                continue
            claim = str(row.get('Утверждение', '')).lower()
            score = _match_score(query_stems, claim)
            if user_text in claim:
                score += 10  # дословное совпадение — сильный приоритет
            if score > best_score:
                best_score = score
                best_row = row

        if best_row is None:
            return None

        # ИСПРАВЛЕНО: строгий порог. Короткие запросы (до 3 ключевых слов)
        # должны совпасть по ВСЕМ словам — иначе «оспа убивает людей»
        # находила «микоплазмы убивают людей».
        overlap = _word_overlap(query_stems, str(best_row.get('Утверждение', '')).lower())
        threshold = 0.99 if len(query_stems) <= 3 else 0.8
        accepted = best_score >= 2 and overlap >= threshold

        if accepted:
            return {
                "source": "google_sheets",
                "verdict": best_row.get('Вердикт', 'НЕЗНАЮ'),
                "explanation": best_row.get('Объяснение', '')
            }
    except Exception:
        print("⚠️ Ошибка чтения Google Sheets:")
        traceback.print_exc()
    return None


