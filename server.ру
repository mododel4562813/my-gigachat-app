@app.route('/api/register', methods=['POST'])
def register():
    data = request.get_json() or {}
    username = str(data.get('username', '')).strip()
    password = str(data.get('password', ''))

    if not username or len(password) < 4:
        return jsonify({"error": "Имя не пустое, пароль от 4 символов"}), 400

    # ЖЕСТКАЯ ПРОВЕРКА: если Sheets нет, регистрация невозможна
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return jsonify({"error": "База пользователей недоступна: Google Таблицы не подключены. Проверьте переменные окружения."}), 500

    try:
        sheet = get_sheet()
        if not sheet:
            return jsonify({"error": "Не удалось открыть таблицу. Проверьте права доступа."}), 500
            
        ws = ensure_worksheet(sheet, "Users")
        if not ws:
            return jsonify({"error": "Не удалось создать или найти лист 'Users'. Проверьте права редактора."}), 500

        # Получаем все записи безопасно
        records = ws.get_all_records()
        existing = [str(r.get('Логин', '')).lower() for r in records if r.get('Логин')]
        
        if username.lower() in existing:
            return jsonify({"error": "Такое имя уже занято"}), 400

        ws.append_row([username, hash_password(password), datetime.now().strftime("%Y-%m-%d %H:%M")])
        print(f"👤 Новый пользователь: {username}")
        return jsonify({"status": "ok", "username": username})
    except Exception as e:
        print("⚠️ Ошибка регистрации:")
        traceback.print_exc()
        return jsonify({"error": "Ошибка регистрации: " + str(e)[:300]}), 500

@app.route('/api/login', methods=['POST'])
def login():
    data = request.get_json() or {}
    username = str(data.get('username', '')).strip()
    password = str(data.get('password', ''))

    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return jsonify({"error": "База пользователей недоступна"}), 500

    try:
        sheet = get_sheet()
        if not sheet: return jsonify({"error": "Таблица не найдена"}), 500
        
        ws = ensure_worksheet(sheet, "Users")
        if not ws: return jsonify({"error": "Лист Users не найден"}), 500

        records = ws.get_all_records()
        for r in records:
            if str(r.get('Логин', '')).lower() == username.lower():
                if str(r.get('Пароль (хэш)', '')) == hash_password(password):
                    return jsonify({"status": "ok", "username": username})
                return jsonify({"error": "Неверный пароль"}), 401
        return jsonify({"error": "Пользователь не найден"}), 404
    except Exception as e:
        print("⚠️ Ошибка входа:")
        traceback.print_exc()
        return jsonify({"error": "Ошибка входа: " + str(e)[:300]}), 500

@app.route('/api/debug')
def debug_gigachat():
    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
        'Authorization': _auth_header_value(),
    }
    info = {
        "proxy_set": bool(PROXY_URL),
        "auth_key_set": bool(GIGACHAT_AUTH_KEY),
        "keys_set": bool(GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET),
        "cert_file": bool(os.path.exists(CERT_PATH)),
    }
    if not (info["auth_key_set"] or info["keys_set"]):
        return jsonify({**info, "result": "Ключи не найдены в Environment"})

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=15
        )
        info["status"] = response.status_code
        info["answer"] = response.text[:80]
        info["result"] = "Токен получен!" if response.status_code == 200 else "Ошибка сервера GigaChat."
    except Exception as e:
        info["status"] = "нет ответа"
        info["answer"] = str(e)[:300]
        info["result"] = "Запрос не дошёл."

    return jsonify(info)

