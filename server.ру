AVATAR_MAX_UPLOAD = 2 * 1024 * 1024
AVATAR_SIDE = 256
AVATAR_JPEG_QUALITY = 80
_avatar_cache = {}


def _shrink_image(raw_bytes):
    if not PIL_OK:
        return None
    try:
        img = Image.open(io.BytesIO(raw_bytes)).convert("RGB")
        img.thumbnail((AVATAR_SIDE, AVATAR_SIDE))
        buf = io.BytesIO()
        img.save(buf, format="JPEG", quality=AVATAR_JPEG_QUALITY)
        return buf.getvalue(), "image/jpeg"
    except Exception:
        return None


def _save_avatar_b64(username, data_bytes, mime):
    try:
        sheet = get_sheet()
        if sheet is None:
            return False
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return False
        colmap = _users_colmap(ws)
        if not colmap:
            return False
        row_idx, _row = _find_user(ws, colmap, username)
        if row_idx is None:
            return False
        encoded = base64.b64encode(data_bytes).decode('ascii')
        if len(encoded) > 45000:
            return False
        ws.update_cell(row_idx, colmap.get("Аватар (base64)", 6), encoded)
        _avatar_cache[username.lower()] = (
            data_bytes, mime, hashlib.md5(data_bytes).hexdigest()[:8])
        return True
    except Exception:
        traceback.print_exc()
        return False


def _load_avatar_bytes(username):
    key = (username or "").strip().lower()
    if not key:
        return None
    if key in _avatar_cache:
        return _avatar_cache[key]
    try:
        sheet = get_sheet()
        if sheet is None:
            return None
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return None
        colmap = _users_colmap(ws)
        if not colmap:
            return None
        row_idx, row = _find_user(ws, colmap, key)
        if row_idx is None:
            return None
        encoded = _cell_str(row, colmap.get("Аватар (base64)", 6))
        if not encoded:
            return None
        data = base64.b64decode(encoded)
        record = (data, "image/jpeg", hashlib.md5(data).hexdigest()[:8])
        _avatar_cache[key] = record
        return record
    except Exception:
        return None


