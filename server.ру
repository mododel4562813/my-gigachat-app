def _compute_leaders():
    """Возвращает топ-10 игроков: [{username, points, level}]."""
    if not GS_CLIENT:
        return []
    try:
        sheet = get_sheet()
        if sheet is None:
            return []

        logs_ws = ensure_worksheet(sheet, "Logs")
        sugg_ws = ensure_worksheet(sheet, "Suggestions")
        game_ws = ensure_worksheet(sheet, "GameScores")
        users_ws = ensure_worksheet(sheet, "Users")

        checked_map, suggested_map, best_score_map = Counter(), Counter(), {}

        if logs_ws:
            for row in logs_ws.get_all_values()[1:]:
                if len(row) >= 4 and str(row[3]).strip() and \
                        str(row[3]).strip().lower() != "гость":
                    checked_map[str(row[3]).strip().lower()] += 1

        if sugg_ws:
            for row in sugg_ws.get_all_values()[1:]:
                if len(row) >= 1 and str(row[0]).strip() and \
                        str(row[0]).strip().lower() != "аноним":
                    suggested_map[str(row[0]).strip().lower()] += 1

        if game_ws:
            for row in game_ws.get_all_values()[1:]:
                if len(row) >= 2 and str(row[0]).strip():
                    name = str(row[0]).strip().lower()
                    try:
                        sc = int(float(row[1] or 0))
                    except (TypeError, ValueError):
                        sc = 0
                    best_score_map[name] = max(best_score_map.get(name, 0), sc)

        leaders = []
        if users_ws:
            for r in users_ws.get_all_records():
                name = str(r.get('Логин', '')).strip()
                if not name:
                    continue
                key = name.lower()
                points = checked_map.get(key, 0) * 2 \
                    + suggested_map.get(key, 0) * 5 \
                    + best_score_map.get(key, 0)
                leaders.append({"username": name, "points": points,
                                "level": level_name(points)})

        leaders.sort(key=lambda x: -x["points"])
        return leaders[:10]
    except Exception:
        traceback.print_exc()
        return []


