def _stem(word):
    for suf in ("ами", "ями", "ого", "его", "ому", "ему", "ыми", "ими",
                "ой", "ый", "ий", "ая", "яя", "ую", "юю", "ом", "ем",
                "ах", "ях", "ей", "ов", "ев", "у", "ю", "а", "я", "ы",
                "и", "е", "ь"):
        if word.endswith(suf) and len(word) - len(suf) >= 4:
            return word[:-len(suf)]
    return word


STOPWORDS = {"это", "правда", "или", "миф", "на", "самом", "деле",
             "вредно", "полезно", "есть", "что", "если", "так", "как",
             "про", "для", "можно", "нужно", "надо", "все", "очень"}


def search_sheets(user_text):
    if not GS_CLIENT:
        return None
    try:
        sheet = get_sheet()
        if sheet is None:
            return None
        ws = ensure_worksheet(sheet, "Facts")
        if ws is None:
            return None
        records = ws.get_all_records()
        if not records:
            return None

        query_words = [w for w in user_text.lower().split()
                       if len(w) > 3 and w not in STOPWORDS]
        query_stems = [_stem(w) for w in query_words]
        if not query_stems:
            return None

        claim_stems_map = {}
        for row in records:
            if str(row.get('Источник', '')).strip().lower() == "ai":
                continue
            claim = str(row.get('Утверждение', '')).lower()
            claim_stems_map[claim] = [_stem(w) for w in claim.split()]

        best_row, best_score, best_overlap = None, 0, 0.0
        for row in records:
            if str(row.get('Источник', '')).strip().lower() == "ai":
                continue
            claim = str(row.get('Утверждение', '')).lower()
            score = sum(1 for qs in query_stems
                        if any(cs.startswith(qs) or qs.startswith(cs)
                               for cs in claim_stems_map.get(claim, [])))
            if user_text in claim:
                score += 10
            if score > best_score:
                best_score = score
                best_row = row
                found = sum(1 for qs in query_stems
                            if any(cs.startswith(qs) or qs.startswith(cs)
                                   for cs in claim_stems_map.get(claim, [])))
                best_overlap = found / len(query_stems)

        if best_row is None:
            return None
        threshold = 0.99 if len(query_stems) <= 3 else 0.8
        if best_score >= 2 and best_overlap >= threshold:
            return {"source": "google_sheets",
                    "verdict": _normalize_verdict(best_row.get('Вердикт', '')),
                    "explanation": str(best_row.get('Объяснение', ''))}
    except Exception:
        print("⚠️ Ошибка чтения Google Sheets:")
        traceback.print_exc()
    return None


