@app.route('/api/challenge', methods=['POST'])
def challenge():
    data = request.get_json() or {}
    claim = str(data.get('claim', '')).strip()
    verdict = str(data.get('verdict', '')).strip()
    reason = str(data.get('reason', '')).strip()

