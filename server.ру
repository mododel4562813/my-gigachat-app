def _user_stats_for_achievements(username):
    stats = {"checked": 0, "suggested": 0, "games": 0, "best_score": 0,
             "comments": 0, "streak": 0, "best_streak": 0}
    if not GS_CLIENT or not username:
        return stats
    try:
        sheet = get_sheet()
        if sheet is None:
            return stats
        stats["checked"] = count_user_rows(ensure_worksheet(sheet, "Logs"),
                                           username, 3)
        stats["suggested"] = count_user_rows(ensure_worksheet(sheet, "Suggestions"),
                                             username, 0)

        game_ws = ensure_worksheet(sheet, "GameScores")
        if game_ws:
            for row in game_ws.get_all_values()[1:]:
                if len(row) >= 4 and row[0].strip().lower() == username.lower():
                    stats["games"] += 1
                    try:
                        stats["best_score"] = max(stats["best_score"],
                                                  int(float(row[1] or 0)))
                    except (TypeError, ValueError):
                        pass

        comm_ws = ensure_worksheet(sheet, "Comments")
        if comm_ws:
            stats["comments"] = count_user_rows(comm_ws, username, 2)

        stats.update(read_streak(username))
    except Exception:
        traceback.print_exc()
    return stats


