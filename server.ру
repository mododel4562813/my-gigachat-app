@app.route('/api/debug')
def debug_gigachat():
    info = {
        "proxy_set": bool(PROXY_URL),
        "auth_key_set": bool(GIGACHAT_AUTH_KEY),
        "keys_set": bool(GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET),
        "cert_file": bool(os.path.exists(CERT_PATH)),
    }
    if not (info["auth_key_set"] or info["keys_set"]):
        return jsonify({**info, "result": "Ключи не найдены"})
    try:
        headers = {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'RqUID': str(uuid.uuid4()),
            'Authorization': _auth_header_value(),
        }
        response = requests.post(
            GIGACHAT_AUTH_URL, headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(), proxies=proxies, timeout=15)
        info["status"] = response.status_code
        info["result"] = ("Токен получен! GigaChat доступен."
                          if response.status_code == 200
                          else "GigaChat ответил ошибкой.")
    except Exception as e:
        info["status"] = "нет ответа"
        info["result"] = f"Запрос не дошёл: {repr(e)[:200]}"
    return jsonify(info)


# Глобальная защита: если где-то всё- случится ошибка — сайт покажет её,
# но сервер не упадёт целиком.
@app.errorhandler(Exception)
def handle_all_errors(e):
    print("❌ Общая ошибка:")
    traceback.print_exc()
    if hasattr(e, 'code'):
        return jsonify({"error": str(e)[:300]}), e.code
    return jsonify({"error": "Внутренняя ошибка сервера"}), 500


