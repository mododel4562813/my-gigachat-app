@app.route('/api/avatar', methods=['POST'])
def upload_avatar():
    username = str(request.form.get('username', '')).strip()[:50]
    if not username:
        return jsonify({"error": "Сначала войдите в аккаунт"}), 400

    file = request.files.get('avatar')
    if not file or not file.filename:
        return jsonify({"error": "Файл не выбран"}), 400

    raw = file.read()
    if len(raw) > AVATAR_MAX_UPLOAD:
        return jsonify({"error": "Файл больше 2 МБ"}), 400

    if PIL_OK:
        processed = _shrink_image(raw)
        if not processed:
            return jsonify({"error": "Это не похоже на изображение"}), 400
        data_bytes, mime = processed
    else:
        if len(raw) > 40000:
            return jsonify({"error": "Выберите картинку поменьше (до 40 КБ)"}), 400
        data_bytes, mime = raw, file.mimetype or "image/png"

    if not _save_avatar_b64(username, data_bytes, mime):
        return jsonify({"error": "Не удалось сохранить аватар"}), 500
    version = hashlib.md5(data_bytes).hexdigest()[:8]
    return jsonify({"status": "ok",
                    "avatar": f"{avatar_url_for(username)}?v={version}"})


@app.route('/api/avatar/<username>')
def get_avatar(username):
    record = _load_avatar_bytes(username)
    if record is None:
        return jsonify({"error": "Аватар не найден"}), 404
    data, mime, version = record
    resp = Response(data, mimetype=mime)
    resp.headers["Cache-Control"] = "public, max-age=86400"
    resp.headers["ETag"] = version
    return resp


@app.route('/api/challenge', methods=['POST'])
def challenge():
    data = request.get_json() or {}
    claim = str(data.get('claim', '')).strip()
    verdict = str(data.get('verdict', '')).strip()
    reason = str(data.get('reason', '')).strip()

    if not reason or len(reason) < 5:
        return jsonify({"error": "Опишите причину чуть подробнее"}), 400
    if len(reason) > 500:
        return jsonify({"error": "Слишком длинное сообщение"}), 400

    ip = request.remote_addr or "?"
    now = time.time()
    last = _challenge_times.get(ip, 0)
    if now - last < CHALLENGE_COOLDOWN:
        wait = int(CHALLENGE_COOLDOWN - (now - last))
        return jsonify({"error": f"Подождите {wait} сек."}), 429
    _challenge_times[ip] = now

    sheet_append("Disputes", [claim[:200], reason[:500], "новый", "",
                              datetime.now().strftime("%Y-%m-%d %H:%M")])

    answer = ask_gigachat_challenge(claim, verdict, reason)
    if not answer:
        return jsonify({"error": "Не удалось перепроверить ответ. Попробуйте позже"}), 503
    return jsonify({"answer": answer})


