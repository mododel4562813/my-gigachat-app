def hash_password(password):
    return hashlib.sha256(password.encode('utf-8')).hexdigest()


USER_EXTRA_HEADERS = ["Последний визит", "Серия", "Лучшая серия",
                      "Всего дней", "Аватар (base64)"]


def _users_colmap(ws):
    try:
        values = ws.get_all_values()
        header = values[0] if values else []
        colmap = {}
        for i, name in enumerate(header):
            colmap[str(name).strip()] = i + 1
        for extra in USER_EXTRA_HEADERS:
            if extra not in colmap:
                new_idx = len(header) + 1
                ws.update_cell(1, new_idx, extra)
                colmap[extra] = new_idx
                header.append(extra)
        return colmap
    except Exception:
        return None


def _find_user(ws, colmap, username):
    try:
        values = ws.get_all_values()
        target = username.strip().lower()
        for i, row in enumerate(values[1:]):
            if row and str(row[0]).strip().lower() == target:
                return i + 2, row
        return None, None
    except Exception:
        return None, None


def _cell_int(row, col_idx, default=0):
    try:
        raw = str(row[col_idx - 1]).strip()
        return int(float(raw)) if raw else default
    except (ValueError, IndexError):
        return default


def _cell_str(row, col_idx):
    try:
        return str(row[col_idx - 1]).strip()
    except IndexError:
        return ""


def avatar_url_for(username):
    return f"/api/avatar/{username}"


def update_streak_in_sheet(username):
    if not GS_CLIENT or not username:
        return None
    try:
        sheet = get_sheet()
        if sheet is None:
            return None
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return None
        colmap = _users_colmap(ws)
        if not colmap:
            return None
        row_idx, row = _find_user(ws, colmap, username)
        if row_idx is None:
            return None

        today = date.today().isoformat()
        yesterday = (date.today() - timedelta(days=1)).isoformat()

        c_last = colmap.get("Последний визит", 2)
        c_streak = colmap.get("Серия", 3)
        c_best = colmap.get("Лучшая серия", 4)
        c_total = colmap.get("Всего дней", 5)

        last_visit = _cell_str(row, c_last)
        streak = _cell_int(row, c_streak)
        best = _cell_int(row, c_best)
        total = _cell_int(row, c_total)

        if last_visit != today:
            streak = streak + 1 if last_visit == yesterday else 1
            total += 1
            best = max(best, streak)
            ws.update_cell(row_idx, c_last, today)
            ws.update_cell(row_idx, c_streak, streak)
            ws.update_cell(row_idx, c_best, best)
            ws.update_cell(row_idx, c_total, total)

        avatar_cell = _cell_str(row, colmap.get("Аватар (base64)", 6))
        return {"streak": streak, "best_streak": best, "total_days": total,
                "avatar": avatar_url_for(username) if avatar_cell else None}
    except Exception:
        traceback.print_exc()
        return None


