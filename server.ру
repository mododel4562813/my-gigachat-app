@app.route('/api/register', methods=['POST'])
def register():
    data = request.get_json() or {}
    username = str(data.get('username', '')).strip()
    password = str(data.get('password', ''))

    if not username or len(password) < 4:
        return jsonify({"error": "Имя не пустое, пароль от 4 символов"}), 400

    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return jsonify({"error": "База пользователей недоступна: "
                                 "Google Таблицы не подключены"}), 500

    try:
        sheet = get_sheet()
        if sheet is None:
            return jsonify({"error": "Не удалось открыть таблицу — "
                                     "проверьте права доступа"}), 500
        ws = ensure_worksheet(sheet, "Users")
        if ws is None:
            return jsonify({"error": "Лист 'Users' не найден — "
                                     "дайте сервис-аккаунту права редактора"}), 500

        records = ws.get_all_records()
        existing = [str(r.get('Логин', '')).lower()
                    for r in records if r.get('Логин')]
        if username.lower() in existing:
            return jsonify({"error": "Такое имя уже занято"}), 400

        # НОВОЕ: при регистрации сразу пишем стартовые значения серии,
        # чтобы колонки существовали с первого дня
        ws.append_row([username, hash_password(password),
                       datetime.now().strftime("%Y-%m-%d %H:%M")])

        # И сразу засчитываем первый день серии
        try:
            _users_colmap(ws)
            update_streak_in_sheet(username)
        except Exception:
            pass  # серия не критична для успешной регистрации

        print(f"👤 Новый пользователь: {username}")
        return jsonify({"status": "ok", "username": username})
    except Exception as e:
        print("⚠️ Ошибка регистрации:")
        traceback.print_exc()
        return jsonify({"error": "Ошибка регистрации: "
                                 + str(repr(e))[:300]}), 500


