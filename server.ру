import os
import json
import base64
import requests
from flask import Flask, request, jsonify, render_template
from flask_cors import CORS
from datetime import datetime
from dotenv import load_dotenv
import gspread
from google.oauth2.service_account import Credentials

load_dotenv()

app = Flask(__name__)
CORS(app)

GIGACHAT_CLIENT_ID = os.environ.get('GIGACHAT_CLIENT_ID')
GIGACHAT_CLIENT_SECRET = os.environ.get('GIGACHAT_CLIENT_SECRET')
GIGACHAT_API_URL = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions"
PROXY_URL = os.environ.get('PROXY_URL')

proxies = {
  'http': PROXY_URL,
  'https': PROXY_URL
} if PROXY_URL else None

MOCK_FACTS = {
    "прививка": {"verdict": "ФЕЙК", "explanation": "Прививки не содержат чипов и не используются для слежки."},
    "земля": {"verdict": "ПРАВДА", "explanation": "Земля имеет форму геоида, близкую к шару."}
}

GS_CLIENT = None
try:
    scopes = ['https://www.googleapis.com/auth/spreadsheets', 'https://www.googleapis.com/auth/drive']
    creds = Credentials.from_service_account_file('credentials.json', scopes=scopes)
    GS_CLIENT = gspread.authorize(creds)
    print("✅ Google Таблицы успешно подключены!")
except Exception as e:
    print(f"⚠️ Ошибка при подключении к Google Sheets: {e}")
    print("Проверьте: файл credentials.json лежит рядом с server.py и у аккаунта есть доступ.")
    GS_CLIENT = None

def ask_gigachat(user_text):
    if not GIGACHAT_CLIENT_ID or not GIGACHAT_CLIENT_SECRET:
        print("⚠️ Не заданы ключи GigaChat в .env")
        return {"verdict": "НЕЗНАЮ", "explanation": "Ключи GigaChat не настроены."}

    auth_string = f"{GIGACHAT_CLIENT_ID}:{GIGACHAT_CLIENT_SECRET}"
    encoded_auth = base64.b64encode(auth_string.encode('utf-8')).decode('utf-8')
    
    token_url = "https://ngw.devices.sberbank.ru:9443/api/v2/oauth"
    headers_auth = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': '12345678-1234-1234-1234-123456789012',
        'Authorization': f'Basic {encoded_auth}'
    }
    payload_auth = {'scope': 'GIGACHAT_API_PERS'}

    try:
        response = requests.post(token_url, headers=headers_auth, data=payload_auth, verify=False, proxies=proxies)
        response.raise_for_status()
        token = response.json().get('access_token')
    except Exception as e:
        print(f"Ошибка получения токена: {e}")
        return {"verdict": "НЕЗНАЮ", "explanation": "Ошибка авторизации GigaChat."}

    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }
    
    prompt = f"Проверь факт: '{user_text}'. Ответь строго в формате JSON: {{\"verdict\": \"ПРАВДА/ФЕЙК/НЕЗНАЮ\", \"explanation\": \"краткое объяснение\"}}"
    
    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1
    }

    try:
        response = requests.post(
            GIGACHAT_API_URL,
            headers=headers,
            json=payload,
            verify='russia_trusted_root.pem',
            proxies=proxies
        )
        response.raise_for_status()
        
        content = response.json()['choices'][0]['message']['content']
        
        try:
            result = json.loads(content)
            return {
                "verdict": result.get("verdict", "НЕЗНАЮ"),
                "explanation": result.get("explanation", "Ошибка парсинга ответа от GigaChat.")
            }
        except json.JSONDecodeError:
            return {"verdict": "НЕЗНАЮ", "explanation": "Ошибка формата ответа"}
            
    except Exception as e:
        print(f"Ошибка при запросе к GigaChat: {e}")
        return {"verdict": "НЕЗНАЮ", "explanation": str(e)}

@app.route('/')
def index():
    return render_template('index.html')

@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).lower().strip()

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    result = None

    if GS_CLIENT:
        try:
            facts_sheet = GS_CLIENT.worksheet("Facts")
            records = facts_sheet.get_all_records()
            for row in records:
                claim = str(row.get('Утверждение', '')).lower()
                if user_text in claim:
                    result = {
                        "verdict": row.get('Вердикт', 'НЕЗНАЮ'),
                        "explanation": row.get('Объяснение', '')
                    }
                    break
        except Exception as e:
            print(f"⚠️ Ошибка чтения Google Sheets: {e}")

    if not result:
        for key, value in MOCK_FACTS.items():
            if key in user_text:
                result = {
                    "verdict": value.get("verdict"),
                    "explanation": value.get("explanation")
                }
                break

    if not result:
        result = ask_gigachat(user_text)

    print(f"[LOG] Запрос: '{user_text}' -> Вердикт: {result.get('verdict', 'НЕЗНАЮ')}")
    return jsonify(result)

@app.route('/api/rate', methods=['POST'])
def rate_answer():
    data = request.get_json() or {}
    claim = data.get('claim')
    rating = data.get('rating')

    if not claim or rating is None:
        return jsonify({"error": "Недостаточно данных"}), 400

    if GS_CLIENT:
        try:
            rating_sheet = GS_CLIENT.worksheet("Ratings")
            rating_sheet.append_row([claim, rating, datetime.now().strftime("%Y-%m-%d %H:%M")])
            print(f"✅ Оценка {rating}/5 для '{claim}' сохранена.")
            return jsonify({"status": "ok"})
        except Exception as e:
            print(f"⚠️ Ошибка записи оценки: {e}")
            return jsonify({"status": "ok", "warning": "Оценка не записана"})
    else:
        return jsonify({"status": "ok", "warning": "Sheets не подключен"})

@app.route('/api/review', methods=['POST'])
def submit_review():
    data = request.get_json() or {}
    name = data.get('name', 'Аноним')
    review_text = str(data.get('review', '')).strip()

    if not review_text:
        return jsonify({"error": "Пустой отзыв"}), 400

    if GS_CLIENT:
        try:
            review_sheet = GS_CLIENT.worksheet("Reviews")
            review_sheet.append_row([name, review_text, datetime.now().strftime("%Y-%m-%d %H:%M")])
            print(f"✅ Отзыв от {name} сохранен.")
        except Exception as e:
            print(f"⚠️ Ошибка записи отзыва: {e}")

    print(f"📝 [ОТЗЫВ] Имя: {name} | Текст: {review_text}")
    return jsonify({"status": "ok"})

if __name__ == '__main__':
    print("🚀 Сервер запущен...")
    port = int(os.environ.get('PORT', 8080))
    app.run(host='0.0.0.0', port=port, debug=False)
