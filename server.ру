@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).strip()

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    text_lower = user_text.lower()

    # Приоритет: 1. Локальная база -> 2. Google Таблица -> 3. GigaChat
    result = find_fact(text_lower)
    
    if not result:
        result = search_sheets(text_lower)
    
    if not result:
        result = ask_gigachat(text_lower)
        if result and result.get("verdict") not in ("НЕЗНАЮ", None):
            add_fact_to_sheet(text_lower, result["verdict"], result.get("explanation", ""))

    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": "Информация не найдена. Попробуйте перефразировать запрос."
        }

    result["verdict"] = _normalize_verdict(result.get("verdict", "НЕЗНАЮ"))
    
    # Финальная проверка на абсурд (на случай если GigaChat вернул что-то странное после парсинга)
    if _is_absurd_myth(result["verdict"], result["explanation"]):
        result["verdict"] = "СПОРНО"
        result["explanation"] = "Утверждение имеет под собой научную основу, но требует уточнения контекста. Не является полностью опровергнутым."

    log_to_sheet(text_lower, result.get("verdict", "НЕЗНАЮ"))
    print(f"[LOG] '{text_lower}' -> {result.get('verdict')} ({result.get('source')})")
    
    return jsonify(result)

