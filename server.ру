@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).strip()

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    text_lower = user_text.lower()

    # 1. Локальная база -> 2. Google Таблица -> 3. GigaChat
    result = find_fact(text_lower)
    if not result:
        result = search_sheets(text_lower)
    if not result:
        result = ask_gigachat(text_lower)

        if result and result.get("verdict") not in ("НЕЗНАЮ", None):
            add_fact_to_sheet(text_lower, result["verdict"],
                              result.get("explanation", ""))

    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": ("Информация не найдена. Сервис работает в "
                            "офлайн-режиме — попробуйте позже или "
                            "переформулируйте запрос.")
        }

    result["verdict"] = _normalize_verdict(result.get("verdict", "НЕЗНАЮ"))

    explanation = str(result.get("explanation", "")).lower()
    danger_words = ("скорую", "скорая", "срочно", "немедленно",
                    "угрожает жизни", "критическ", "экстренн")
    if result["verdict"] in ("ПРАВДА", "МИФ") and any(
            w in explanation for w in danger_words) and "103" not in explanation:
        result["explanation"] = str(result.get("explanation", "")).rstrip(".") + \
            ". " + AMBULANCE_NOTE

    log_to_sheet(text_lower, result.get("verdict", "НЕЗНАЮ"))
    print(f"[LOG] '{text_lower}' -> {result.get('verdict')} "
          f"({result.get('source')})")
    return jsonify(result)


