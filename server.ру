    now = time.time()
    if _stats_cache["data"] is not None and now - _stats_cache["ts"] < STATS_CACHE_TTL:
        return jsonify(_stats_cache["data"])

    result = {"rating": None, "best_player": None,
              "best_player_points": None, "myth_of_day": None}

    if GS_CLIENT:
        try:
            sheet = get_sheet()
            if sheet is not None:
                # Средняя оценка по сердечкам (лист Ratings: [claim, rating, ...])
                ratings_ws = ensure_worksheet(sheet, "Ratings")
                if ratings_ws:
                    vals = []
                    for r in ratings_ws.get_all_values()[1:]:
                        try:
                            vals.append(float(str(r[1]).replace(',', '.')))
                        except (TypeError, ValueError, IndexError):
                            pass
                    if vals:
                        result["rating"] = round(sum(vals) / len(vals), 1)

                # Лучший игрок — №1 из рейтинга
                leaders = _compute_leaders()
                if leaders:
                    result["best_player"] = leaders[0]["username"]
                    result["best_player_points"] = leaders[0]["points"]

                # Миф дня — самый проверяемый
                myth = _compute_myth_of_day()
                if myth.get("claim"):
                    result["myth_of_day"] = myth["claim"]
        except Exception:
            traceback.print_exc()

    _stats_cache["data"] = result
    _stats_cache["ts"] = now
    return jsonify(result)


