CACHE_MAX_SIZE = 500
_answer_cache = {}  # normalized claim -> {"verdict":..., "explanation":..., "ts":...}


def normalize_text(text):
    """Приводит запрос к одному виду: нижний регистр, без пунктуации, без лишних пробелов."""
    import re
    text = str(text).lower().strip()
    text = re.sub(r"[^\w\s]", " ", text, flags=re.UNICODE)  # убрать пунктуацию
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def cache_get(key):
    record = _answer_cache.get(key)
    if record is None:
        return None
    # кэш живёт 3 часа, потом обновим через ИИ
    if time.time() - record["ts"] > 3 * 3600:
        _answer_cache.pop(key, None)
        return None
    return record


def cache_put(key, verdict, explanation):
    if len(_answer_cache) >= CACHE_MAX_SIZE:
        # выбрасываем самую старую запись
        oldest = min(_answer_cache, key=lambda k: _answer_cache[k]["ts"])
        _answer_cache.pop(oldest, None)
    _answer_cache[key] = {"verdict": verdict, "explanation": explanation, "ts": time.time()}


