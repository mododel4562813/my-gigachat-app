def get_gigachat_token():
    """Получение токена доступа к GigaChat"""
    if not GIGACHAT_CLIENT_ID or not GIGACHAT_CLIENT_SECRET:
        print("⚠️ Не заданы ключи GigaChat в .env")
        return None

    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': '12345678-1234-1234-1234-123456789012'
    }
    
    auth_string = f"{GIGACHAT_CLIENT_ID}:{GIGACHAT_CLIENT_SECRET}"
    encoded_auth = base64.b64encode(auth_string.encode('utf-8')).decode('utf-8')
    headers['Authorization'] = f'Basic {encoded_auth}'

    payload = {'scope': 'GIGACHAT_API_PERS'}

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data=payload,
            verify=False,
            proxies=proxies
        )
        response.raise_for_status()
        
        token = response.json().get('access_token')
        
        if token:
            print("✅ Токен GigaChat успешно получен!")
            return token
        else:
            print("⚠️ В ответе от GigaChat нет токена")
            return None
            
    except Exception as e:
        print(f"⚠️ Ошибка авторизации в GigaChat: {e}")
        return None


def find_answer(user_question, spreadsheet_id, worksheet_name):
    """
    Логика поиска ответа:
    1. Google Sheets (приоритет 1)
    2. MOCK_FACTS (приоритет 2)
    3. GigaChat (приоритет 3)
    """
    
    # --- ШАГ 1: Поиск в Google Sheets ---
    if GS_CLIENT:
        try:
            spreadsheet = GS_CLIENT.open_by_key(spreadsheet_id)
            worksheet = spreadsheet.worksheet(worksheet_name)
            all_data = worksheet.get_all_values()
            
            clean_question = user_question.lower().replace('.', '').replace(',', '').replace('?', '').replace('!', '')
            question_words = set(clean_question.split())
            
            for row in all_data[1:]:
                if len(row) < 3: 
                    continue
                
                keywords_str = row[0] if row[0] else ""
                answer_text = row[1] if row[1] else ""
                verdict_text = row[2] if row[2] else ""
                
                keywords_set = set(keywords_str.lower().split())
                
                if keywords_set.issubset(question_words) and len(keywords_set) > 0:
                    return {
                        "source": "google_sheets",
                        "verdict": verdict_text,
                        "answer": answer_text
                    }
                    
        except Exception as e:
            print(f"⚠️ Ошибка чтения Google Таблиц: {e}")

    # --- ШАГ 2: Поиск в локальной базе (MOCK_FACTS) ---
    for key, value in MOCK_FACTS.items():
        if key.lower() in user_question.lower():
            return {
                "source": "mock_facts",
                "verdict": value.get("verdict", "НЕЗНАЮ"),
                "answer": value.get("answer", "Нет данных")
            }

    # --- ШАГ 3: GigaChat (если ничего не нашли) ---
    return {
        "source": "gigachat_placeholder",
        "verdict": "НЕЗНАЮ",
        "answer": "Информация не найдена в базе, требуется запрос к нейросети."
    }


def ask_gigachat(user_text):
    token = get_gigachat_token()
    if not token:
        return {"verdict": "НЕЗНАЮ", "explanation": "Токен для GigaChat не получен. Проверьте credentials.json."}

    prompt = (
        "Ты — строгий медицинский фактчекер. Пользователь утверждает: \"" + user_text + "\". "
        "Твоя задача — проверить это утверждение с научной точки зрения. "
        "Верни ответ СТРОГО в формате JSON (без markdown-разметки, только чистый JSON): "
        "{\"verdict\": \"МИФ\" | \"ПРАВДА\" | \"СПОРНО\" | \"НЕЗНАЮ\", "
        "\"explanation\": \"Подробное объяснение с указанием причин. Если не знаешь или вопрос требует индивидуальной консультации, пиши: Не давай медицинских назначений.\"}"
    )

    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }

    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1
    }

    try:
        response = requests.post(
            GIGACHAT_API_URL,
            headers=headers,
            json=payload,
            verify='russia_trusted_root.pem',
            proxies=proxies
        )
        response.raise_for_status()
        
        data = response.json()
        content = data['choices'][0]['message']['content']

        result = json.loads(content)
        return {
            "verdict": result.get("verdict", "НЕЗНАЮ"),
            "explanation": result.get("explanation", "Ошибка парсинга ответа от GigaChat.")
        }
    except json.JSONDecodeError:
        return {"verdict": "НЕЗНАЮ", "explanation": "Ошибка формата ответа"}
    except Exception as e:
        print(f"❌ Ошибка при запросе к GigaChat: {e}")
        return {"verdict": "НЕЗНАЮ", "explanation": str(e)}


