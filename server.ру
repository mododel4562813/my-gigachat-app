                continue
            try:
                difficulty = int(row.get('Сложность') or 1)
            except (TypeError, ValueError):
                difficulty = 1
            items.append({
                "statement": claim,
                "truth": verdict == "ПРАВДА",
                "explain": str(row.get('Объяснение', ''))[:300],
                "difficulty": max(1, min(3, difficulty))
            })
        random.shuffle(items)
        return jsonify({"questions": items[:24]})
    except Exception:
        return jsonify({"questions": []})


LEVELS = [(0, "🌱 Новичок"), (20, "🔍 Доказатель"), (60, "👑 Хранитель истины")]


def level_name(points):
    current = LEVELS[0][1]
    for threshold, name in LEVELS:
        if points >= threshold:
            current = name
    return current


def count_user_rows(ws, username, column_index=0):
    if ws is None or not username:
        return 0
    try:
        values = ws.get_all_values()
        return sum(1 for row in values[1:]
                   if len(row) > column_index
                   and str(row[column_index]).strip().lower()
                   == username.strip().lower())
    except Exception:
        return 0


@app.route('/api/profile')
def profile():
    username = request.args.get('username', '').strip()
    if not username:
        return jsonify({"error": "Не передано имя пользователя"}), 400

    base = {"checked": 0, "suggested": 0, "points": 0, "level": "🌱 Новичок",
            "activity": [0] * 7, "streak": 0, "best_streak": 0,
            "total_days": 0, "avatar": None}

    if not GS_CLIENT:
        return jsonify(base)
    try:
        sheet = get_sheet()
        if sheet is None:
            return jsonify(base)
        logs_ws = ensure_worksheet(sheet, "Logs")
        suggest_ws = ensure_worksheet(sheet, "Suggestions")

        checked = count_user_rows(logs_ws, username, column_index=3)
        suggested = count_user_rows(suggest_ws, username, column_index=0)

        activity = [0] * 7
        try:
            today = datetime.now().date()
            values = logs_ws.get_all_values() if logs_ws else []
            for row in values[1:]:
                if len(row) < 4:
                    continue
                if str(row[3]).strip().lower() != username.strip().lower():
                    continue
                try:
                    row_date = datetime.strptime(str(row[2])[:10], "%Y-%m-%d").date()
                except ValueError:
                    continue
                days_ago = (today - row_date).days
                if 0 <= days_ago < 7:
                    activity[6 - days_ago] += 1
        except Exception:
            pass

        points = checked * 2 + suggested * 5

        streak_info = update_streak_in_sheet(username) or \
            {"streak": 0, "best_streak": 0, "total_days": 0, "avatar": None}

        return jsonify({
            "checked": checked, "suggested": suggested, "points": points,
            "level": level_name(points), "activity": activity,
            "streak": streak_info.get("streak", 0),
            "best_streak": streak_info.get("best_streak", 0),
            "total_days": streak_info.get("total_days", 0),
            "avatar": streak_info.get("avatar")
        })
    except Exception:
        traceback.print_exc()
        return jsonify(base)


