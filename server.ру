from facts import find_fact  # локальная база фактов

# ---------- Пути ----------
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
load_dotenv(os.path.join(BASE_DIR, '.env'))
CERT_PATH = os.path.join(BASE_DIR, 'russia_trusted_root.pem')

app = Flask(__name__)

# ---------- GigaChat ----------
GIGACHAT_CLIENT_ID = os.getenv("GIGACHAT_CLIENT_ID", "").strip().strip('"').strip("'")
GIGACHAT_CLIENT_SECRET = os.getenv("GIGACHAT_CLIENT_SECRET", "").strip().strip('"').strip("'")
GIGACHAT_AUTH_KEY = os.getenv("GIGACHAT_AUTH_KEY", "").strip().strip('"').strip("'")

GIGACHAT_AUTH_URL = "https://ngw.devices.sberbank.ru:9443/api/v2/oauth"
GIGACHAT_API_URL = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions"

# ---------- ПРОКСИ ----------
# Прокси нужен, потому что серверы Render находятся за границей,
# а API Сбера может не отвечать на зарубежные IP.
# Формат: http://логин:пароль@адрес_прокси:порт
PROXY_URL = os.getenv("PROXY_URL", "").strip()
proxies = {"http": PROXY_URL, "https": PROXY_URL} if PROXY_URL else None

if PROXY_URL:
    print("✅ Прокси включён")
else:
    print("ℹ️ Прокси не задан — запросы к GigaChat пойдут напрямую")

if GIGACHAT_AUTH_KEY:
    print("✅ Authorization Key найден (GIGACHAT_AUTH_KEY)")
elif GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET:
    print("✅ Ключи GigaChat найдены")
else:
    print("⚠️ Ключи GigaChat не найдены — ИИ будет отключён")

_token_cache = {"token": None, "time": 0}


def _gigachat_verify():
    """Если сертификат лежит рядом — проверяем SSL, если нет — не проверяем."""
    return CERT_PATH if os.path.exists(CERT_PATH) else False


def _auth_header_value():
    """Значение заголовка Authorization для GigaChat.
    Если задан GIGACHAT_AUTH_KEY (готовая base64-строка) — используем её как есть.
    Иначе собираем заголовок из пары CLIENT_ID:CLIENT_SECRET."""
    if GIGACHAT_AUTH_KEY:
        return 'Basic ' + GIGACHAT_AUTH_KEY
    auth_string = f"{GIGACHAT_CLIENT_ID}:{GIGACHAT_CLIENT_SECRET}"
    return 'Basic ' + base64.b64encode(auth_string.encode('utf-8')).decode('utf-8')


def get_gigachat_token():
    """Токен GigaChat с кэшем на 25 минут."""
    if _token_cache["token"] and time.time() - _token_cache["time"] < 1500:
        return _token_cache["token"]

    if not (GIGACHAT_AUTH_KEY or (GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET)):
        return None

    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
        'Authorization': _auth_header_value(),
    }

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=15
        )
        print(f"📡 Авторизация GigaChat: статус {response.status_code}")
        response.raise_for_status()

        token = response.json().get('access_token')
        if token:
            print("✅ Токен GigaChat получен!")
            _token_cache["token"] = token
            _token_cache["time"] = time.time()
            return token

        print("⚠️ В ответе нет access_token:", response.text[:200])
        return None
    except Exception as e:
        print(f"❌ Ошибка авторизации GigaChat: {e}")
        return None


def _extract_json(text):
    """Вытаскивает чистый JSON из ответа модели:
    срезает обёртку ```json ... ``` и всё лишнее вокруг фигурных скобок."""
    text = text.strip()
    if text.startswith("```"):
        text = text.strip("`")
        if text.lower().startswith("json"):
            text = text[4:]
        text = text.strip()
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end != -1 and end > start:
        return text[start:end + 1]
    return text


def ask_gigachat(user_text):
    """Запрос к GigaChat. Возвращает None, если ИИ недоступен."""
    token = get_gigachat_token()
    if not token:
        return None

    prompt = (
        "Ты — медицинский фактчекер. Пользователь утверждает: \"" + user_text + "\". "
        "Проверь утверждение с научной точки зрения. Ответь СТРОГО в формате JSON "
        "(без markdown, только чистый JSON): {\"verdict\": \"МИФ\" | \"ПРАВДА\" | "
        "\"СПОРНО\" | \"НЕЗНАЮ\", \"explanation\": \"краткое объяснение\"}. "
        "Не давай медицинских назначений — вместо этого пиши «обратитесь к врачу»."
    )

    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'Authorization': f'Bearer {token}'
    }
    payload = {
        "model": "GigaChat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1
    }

    try:
        response = requests.post(
            GIGACHAT_API_URL,
            headers=headers,
            json=payload,
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=30
        )
        response.raise_for_status()
        content = response.json()['choices'][0]['message']['content']
        content = _extract_json(content)

        try:
            result = json.loads(content)
            return {
                "source": "gigachat",
                "verdict": result.get("verdict", "НЕЗНАЮ"),
                "explanation": result.get("explanation", "")
            }
        except json.JSONDecodeError:
            return {"source": "gigachat", "verdict": "НЕЗНАЮ",
                    "explanation": content[:500]}
    except Exception as e:
        print(f"❌ Ошибка запроса к GigaChat: {e}")
        return None


# ---------- Google Sheets ----------
GS_CLIENT = None
GOOGLE_SPREADSHEET_ID = os.getenv("GOOGLE_SPREADSHEET_ID", "").strip()
GOOGLE_CREDENTIALS = os.getenv("GOOGLE_CREDENTIALS")  # JSON одной строкой
CREDENTIALS_FILE = os.path.join(BASE_DIR, "credentials.json")

scopes = [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/drive"
]

if GOOGLE_SPREADSHEET_ID:
    try:
        if GOOGLE_CREDENTIALS:
            info = json.loads(GOOGLE_CREDENTIALS)
            creds = Credentials.from_service_account_info(info, scopes=scopes)
            GS_CLIENT = gspread.authorize(creds)
            print("✅ Google Таблицы подключены (из переменной GOOGLE_CREDENTIALS)")
        elif os.path.exists(CREDENTIALS_FILE):
            creds = Credentials.from_service_account_file(
                CREDENTIALS_FILE, scopes=scopes)
            GS_CLIENT = gspread.authorize(creds)
            print("✅ Google Таблицы подключены (из файла credentials.json)")
        else:
            print("⚠️ Нет ни GOOGLE_CREDENTIALS, ни credentials.json — таблицы отключены")
    except Exception as e:
        print(f"❌ Ошибка подключения к Google Sheets: {e}")
        GS_CLIENT = None
else:
    print("ℹ️ GOOGLE_SPREADSHEET_ID не задан — таблицы отключены")


def search_sheets(user_text):
    """Поиск в листе Facts (колонки: Утверждение, Вердикт, Объяснение)."""
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return None
    try:
        spreadsheet = GS_CLIENT.open_by_key(GOOGLE_SPREADSHEET_ID)
        records = spreadsheet.worksheet("Facts").get_all_records()
        user_text = user_text.lower().strip()

        for row in records:
            claim = str(row.get('Утверждение', '')).lower()
            if user_text in claim or any(
                    w in claim for w in user_text.split() if len(w) > 4):
                return {
                    "source": "google_sheets",
                    "verdict": row.get('Вердикт', 'НЕЗНАЮ'),
                    "explanation": row.get('Объяснение', '')
                }
    except Exception as e:
        print(f"⚠️ Ошибка чтения Google Sheets: {e}")
    return None


def log_to_sheet(user_text, verdict):
    """Лог запроса в лист Logs."""
    if not GS_CLIENT or not GOOGLE_SPREADSHEET_ID:
        return
    try:
        sheet = GS_CLIENT.open_by_key(GOOGLE_SPREADSHEET_ID)
        sheet.worksheet("Logs").append_row(
            [user_text, verdict, datetime.now().strftime("%Y-%m-%d %H:%M")])
    except Exception as e:
        print(f"⚠️ Ошибка логирования: {e}")


# ---------- Маршруты ----------
@app.route('/')
def index():
    return render_template('index.html')


@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).strip()

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    text_lower = user_text.lower()

    # 1. Google Таблица -> 2. Локальная база -> 3. GigaChat
    result = search_sheets(text_lower)
    if not result:
        result = find_fact(text_lower)
    if not result:
        result = ask_gigachat(text_lower)
    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": ("Информация не найдена. Сервис работает в "
                            "офлайн-режиме — попробуйте позже или "
                            "переформулируйте запрос.")
        }

    log_to_sheet(text_lower, result.get("verdict", "НЕЗНАЮ"))
    print(f"[LOG] '{text_lower}' -> {result.get('verdict')} "
          f"({result.get('source')})")
    return jsonify(result)


@app.route('/api/rate', methods=['POST'])
def rate_answer():
    data = request.get_json() or {}
    claim = data.get('claim')
    rating = data.get('rating')

    if not claim or rating is None:
        return jsonify({"error": "Нужны поля 'claim' и 'rating'"}), 400

    if GS_CLIENT:
        try:
            sheet = GS_CLIENT.open_by_key(GOOGLE_SPREADSHEET_ID)
            sheet.worksheet("Ratings").append_row(
                [claim, rating, datetime.now().strftime("%Y-%m-%d %H:%M")])
            return jsonify({"status": "ok"})
        except Exception as e:
            print(f"⚠️ Ошибка записи оценки: {e}")
            return jsonify({"status": "ok", "warning": "Оценка не записана"})
    return jsonify({"status": "ok", "warning": "Sheets не подключен"})


@app.route('/api/review', methods=['POST'])
def submit_review():
    data = request.get_json() or {}
    name = data.get('name', 'Аноним')
    review_text = str(data.get('review', '')).strip()

    if not review_text:
        return jsonify({"error": "Пустой отзыв"}), 400

    if GS_CLIENT:
        try:
            sheet = GS_CLIENT.open_by_key(GOOGLE_SPREADSHEET_ID)
            sheet.worksheet("Reviews").append_row(
                [name, review_text, datetime.now().strftime("%Y-%m-%d %H:%M")])
        except Exception as e:
            print(f"⚠️ Ошибка записи отзыва: {e}")
            return jsonify({"status": "ok", "warning": "Отзыв не записан"})
    else:
        print(f"🗣 [ОТЗЫВ] {name}: {review_text}")

    return jsonify({"status": "ok"})


@app.route('/api/debug')
def debug_gigachat():
    """Диагностика: пробует получить токен и показывает ошибку в браузере."""
    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
        'Authorization': _auth_header_value(),
    }
    info = {
        "proxy_set": bool(PROXY_URL),
        "auth_key_set": bool(GIGACHAT_AUTH_KEY),
        "keys_set": bool(GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET),
        "cert_file": bool(os.path.exists(CERT_PATH)),
    }
    if not (info["auth_key_set"] or info["keys_set"]):
        return jsonify({**info, "result": "Ключи не найдены в Environment"})

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=15
        )
        info["status"] = response.status_code
        info["answer"] = response.text[:80]
        if response.status_code == 200:
            info["result"] = "Токен получен! GigaChat доступен."
        else:
            info["result"] = "Сервер GigaChat ответил ошибкой — смотри status и answer."
    except Exception as e:
        info["status"] = "нет ответа"
        info["answer"] = str(e)[:300]
        info["result"] = "Запрос до GigaChat не дошёл (проблема сети/прокси)."

    return jsonify(info)


