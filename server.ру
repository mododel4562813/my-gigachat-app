        traceback.print_exc()
        return jsonify({"error": "Ошибка входа: " + str(repr(e))[:300]}), 500


@app.route('/api/debug')
def debug_gigachat():
    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'RqUID': str(uuid.uuid4()),
        'Authorization': _auth_header_value(),
    }
    info = {
        "proxy_set": bool(PROXY_URL),
        "auth_key_set": bool(GIGACHAT_AUTH_KEY),
        "keys_set": bool(GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET),
        "cert_file": bool(os.path.exists(CERT_PATH)),
    }
    if not (info["auth_key_set"] or info["keys_set"]):
        return jsonify({**info, "result": "Ключи не найдены в Environment"})

    try:
        response = requests.post(
            GIGACHAT_AUTH_URL,
            headers=headers,
            data={'scope': 'GIGACHAT_API_PERS'},
            verify=_gigachat_verify(),
            proxies=proxies,
            timeout=15
        )
        info["status"] = response.status_code
        info["answer"] = response.text[:80]
        if response.status_code == 200:
            info["result"] = "Токен получен! GigaChat доступен."
        else:
            info["result"] = "Сервер GigaChat ответил ошибкой."
    except Exception as e:
        info["status"] = "нет ответа"
        info["answer"] = repr(e)[:300]
        info["result"] = "Запрос до GigaChat не дошёл (сеть/прокси)."

    return jsonify(info)


@app.route('/api/debug_sheets')
def debug_sheets():
    """Показывает, какой ключ видит сервер и есть ли доступ к таблице."""
    info = {}
    try:
        if GOOGLE_CREDENTIALS_B64:
            raw = base64.b64decode(GOOGLE_CREDENTIALS_B64).decode('utf-8')
            info["источник"] = "B64"
        elif GOOGLE_CREDENTIALS:
            raw = GOOGLE_CREDENTIALS
            info["источник"] = "VAR"
        elif os.path.exists(CREDENTIALS_FILE):
            with open(CREDENTIALS_FILE, encoding='utf-8') as f:
                raw = f.read()
            info["источник"] = "FILE"
        else:
            raw = None
            info["источник"] = "нет"

        if raw:
            creds_info = json.loads(raw)
            info["key_id_на_сервере"] = creds_info.get("private_key_id", "?")
            info["сервис_аккаунт"] = creds_info.get("client_email", "?")
        else:
            info["key_id_на_сервере"] = "ключ не найден"
            info["сервис_аккаунт"] = "-"
    except Exception as e:
        info["ошибка_чтения"] = str(e)[:200]

    if GS_CLIENT and GOOGLE_SPREADSHEET_ID:
        try:
            sheet = GS_CLIENT.open_by_key(GOOGLE_SPREADSHEET_ID)
            info["доступ_к_таблице"] = "OK"
            info["листы"] = [w.title for w in sheet.worksheets()]
        except Exception as e:
            info["доступ_к_таблице"] = str(e)[:200]
    return jsonify(info)


