@app.route('/api/check', methods=['POST'])
def check_claim():
    data = request.get_json() or {}
    user_text = str(data.get('text', '')).strip()

    if not user_text:
        return jsonify({"error": "Пустой запрос"}), 400

    text_lower = user_text.lower()

    # 1. Google Таблица -> 2. Локальная база -> 3. GigaChat
    result = search_sheets(text_lower)
    if not result:
        result = find_fact(text_lower)
    if not result:
        result = ask_gigachat(text_lower)

        # НОВОЕ: факт из ИИ дописываем в нашу базу с вердиктом
        if result and result.get("verdict") not in ("НЕЗНАЮ", None):
            add_fact_to_sheet(text_lower, result["verdict"],
                              result.get("explanation", ""))

    if not result:
        result = {
            "source": "none",
            "verdict": "НЕЗНАЮ",
            "explanation": ("Информация не найдена. Сервис работает в "
                            "офлайн-режиме — попробуйте позже или "
                            "переформулируйте запрос.")
        }

    log_to_sheet(text_lower, result.get("verdict", "НЕЗНАЮ"))
    print(f"[LOG] '{text_lower}' -> {result.get('verdict')} "
          f"({result.get('source')})")
    return jsonify(result)


@app.route('/api/rate', methods=['POST'])
def rate_answer():
    data = request.get_json() or {}
    claim = data.get('claim')
    rating = data.get('rating')

    if not claim or rating is None:
        return jsonify({"error": "Нужны поля 'claim' и 'rating'"}), 400

    if GS_CLIENT:
        try:
            sheet = get_sheet()
            ensure_worksheet(sheet, "Ratings").append_row(
                [claim, rating, datetime.now().strftime("%Y-%m-%d %H:%M")])
            return jsonify({"status": "ok"})
        except Exception as e:
            print(f"⚠️ Ошибка записи оценки: {e}")
            return jsonify({"status": "ok", "warning": "Оценка не записана"})
    return jsonify({"status": "ok", "warning": "Sheets не подключен"})


