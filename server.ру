        suggested = count_user_rows(suggest_ws, username, column_index=0)

        # Активность за последние 7 дней
        activity = [0] * 7
        try:
            today = datetime.now().date()
            values = logs_ws.get_all_values() if logs_ws else []
            for row in values[1:]:
                if len(row) < 4:
                    continue
                if str(row[3]).strip().lower() != username.strip().lower():
                    continue
                try:
                    row_date = datetime.strptime(str(row[2])[:10], "%Y-%m-%d").date()
                except ValueError:
                    continue
                days_ago = (today - row_date).days
                if 0 <= days_ago < 7:
                    activity[6 - days_ago] += 1
        except Exception:
            pass

        points = checked * 2 + suggested * 5   # предложение мифа ценнее

        # НОВОЕ: серия дней и аватар из листа Users
        streak_info = get_user_streak_info(username)

        return jsonify({
            "checked": checked,
            "suggested": suggested,
            "points": points,
            "level": level_name(points),
            "activity": activity,
            "streak": streak_info.get("streak", 0),
            "best_streak": streak_info.get("best_streak", 0),
            "total_days": streak_info.get("total_days", 0),
            "avatar": streak_info.get("avatar")
        })
    except Exception:
        print("⚠️ Ошибка сборки профиля:")
        traceback.print_exc()
        base["warning"] = "Ошибка подсчёта статистики"
        return jsonify(base)


