# --- Виртуальное окружение (НИКОГДА не коммить!) ---
venv/
.venv/
env/
ENV/

# --- Кэш и байт-код Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Секреты и ключи (САМОЕ ВАЖНОЕ) ---
# Пароли лежат в Environment на Render, файлы сюда не попадают:
.env
credentials.json
*.pem
*.key
*.p12
*.pub
*.crt
*.csr

# --- Логи и временные файлы ---
*.log
logs/
*.tmp
*.temp

# --- Файлы операционной системы ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Редакторы кода ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Тесты и кэши ---
.pytest_cache/
.coverage
htmlcov/

# --- Артефакты сборки ---
node_modules/
